<Window x:Class="Porjai20.Views.CustomerHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📜 ประวัติการสั่งซื้อลูกค้า" Height="640" Width="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Noto Sans Thai, Leelawadee UI, Microsoft Sans Serif, Tahoma"
        Background="#F4F7FA">

    <Window.Resources>
        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  LOCAL COLOR PALETTE (High-Contrast Crimson Red Theme)    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="PosBg"          Color="#F4F7FA"/>
        <SolidColorBrush x:Key="PosCard"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PosInput"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PosBorder"      Color="#E2E8F0"/>

        <SolidColorBrush x:Key="RosePrimary"    Color="#00A3E0"/>
        <SolidColorBrush x:Key="RoseHover"      Color="#0B2545"/>
        <SolidColorBrush x:Key="RosePressed"    Color="#0082B3"/>
        <SolidColorBrush x:Key="RoseSubtle"     Color="#E0F2FE"/>

        <SolidColorBrush x:Key="TextPrimary"    Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#64748B"/>

        <!-- Soft Shadow Effect -->
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  CIRCULAR MODAL CLOSE BUTTON STYLE                         -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
            <Setter Property="Width"               Value="32"/>
            <Setter Property="Height"              Value="32"/>
            <Setter Property="Background"          Value="#E0F2FE"/>
            <Setter Property="Foreground"          Value="#0B2545"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="FontSize"            Value="15"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <TextBlock x:Name="Txt"
                                       Text="✕"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00A3E0"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0082B3"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Rose Button Style -->
        <Style x:Key="RoseBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#00A3E0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0B2545"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0082B3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  DATAGRID STYLES                                           -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModalColHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"              Value="#F1F5F9"/>
            <Setter Property="Foreground"              Value="#000000"/>
            <Setter Property="FontWeight"              Value="Bold"/>
            <Setter Property="FontSize"                Value="16"/>
            <Setter Property="Height"                  Value="46"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="BorderBrush"             Value="#E2E8F0"/>
            <Setter Property="BorderThickness"         Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#000000"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                CornerRadius="6" Margin="2,1" Padding="4,0"
                                Background="Transparent">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#E0F2FE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#00A3E0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalCellStyle" TargetType="DataGridCell">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontFamily"          Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
        </Style>
        <Style x:Key="ColCenterBold" TargetType="TextBlock" BasedOn="{StaticResource ColCenter}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ColAmountStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="FontFamily"          Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Margin"              Value="0,0,8,0"/>
            <Setter Property="Foreground"          Value="#0B2545"/>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Customer Summary Inset -->
            <RowDefinition Height="*"/>     <!-- History DataGrid Table -->
            <RowDefinition Height="Auto"/>  <!-- Footer Summary -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROW 0 — Header & Circular Close Button                    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="5" CornerRadius="3" Margin="0,0,12,0" VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00A3E0" Offset="0"/>
                            <GradientStop Color="#F4A2B8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="📜 ประวัติการสั่งซื้อลูกค้า"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2D3748"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Circular Close Button -->
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource ModalCloseButtonStyle}"
                    Click="CloseButton_Click"/>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROW 1 — Customer Summary Inset Box                        -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#E0F2FE"
                BorderBrush="#BAE6FD"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="👤 ชื่อลูกค้า:" FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="CustomerNameTextBlock"
                           FontSize="14" FontWeight="Bold" Foreground="#2D3748"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0">
                    <TextBlock Text="📞 เบอร์โทรศัพท์:" FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                </StackPanel>
                <TextBlock Grid.Column="3" x:Name="CustomerPhoneTextBlock"
                           FontSize="14" FontWeight="Bold" Foreground="#2D3748"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROW 2 — History DataGrid Table                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#BAE6FD"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Effect="{StaticResource SoftShadow}">

            <DataGrid x:Name="HistoryDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True" 
                      HeadersVisibility="Column"
                      RowHeight="44"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="True"
                      ColumnHeaderStyle="{StaticResource ModalColHeaderStyle}"
                      RowStyle="{StaticResource ModalRowStyle}"
                      CellStyle="{StaticResource ModalCellStyle}"
                      SelectionMode="Single">
                <DataGrid.Columns>

                    <!-- #1: Timestamp -->
                    <DataGridTextColumn Header="วันที่/เวลา"
                                        Binding="{Binding Timestamp, StringFormat=dd/MM/yyyy HH:mm}"
                                        Width="1.4*"
                                        ElementStyle="{StaticResource ColCenter}"/>

                    <!-- #2: RefNo -->
                    <DataGridTextColumn Header="เลขที่บิล"
                                        Binding="{Binding RefNo}"
                                        Width="1.8*"
                                        ElementStyle="{StaticResource ColCenterBold}"/>

                    <!-- #3: Total Amount -->
                    <DataGridTextColumn Header="ยอดสุทธิ"
                                        Binding="{Binding TotalAmount, StringFormat=฿{0:N2}}"
                                        Width="1.4*"
                                        ElementStyle="{StaticResource ColAmountStyle}"/>

                    <!-- #4: Payment Method -->
                    <DataGridTextColumn Header="วิธีการชำระ"
                                        Binding="{Binding PaymentMethod}"
                                        Width="1.2*"
                                        ElementStyle="{StaticResource ColCenter}"/>

                    <!-- #5: Delivery Status -->
                    <DataGridTextColumn Header="สถานะจัดส่ง"
                                        Binding="{Binding DeliveryStatus}"
                                        Width="1.2*"
                                        ElementStyle="{StaticResource ColCenter}"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROW 3 — Footer Summary Bar                                -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="#BAE6FD"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,16,0,0"
                Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="จำนวนรายการรวม: " FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                    <TextBlock x:Name="TotalOrdersTextBlock" FontSize="14" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,24,0"/>

                    <TextBlock Text="ยอดรวมทั้งหมด: " FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                    <TextBlock x:Name="TotalSpentTextBlock" FontSize="16" FontWeight="Bold" Foreground="#0B2545"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="ปิดหน้าต่าง"
                        Click="CloseButton_Click"
                        Style="{StaticResource RoseBtnStyle}"
                        Background="#E0F2FE"
                        Foreground="#718096"
                        BorderBrush="#BAE6FD"
                        BorderThickness="1"
                        Padding="20,0" Height="36"/>
            </Grid>
        </Border>
    </Grid>
</Window>
