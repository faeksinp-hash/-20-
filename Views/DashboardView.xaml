<UserControl x:Class="Porjai20.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Porjai20.ViewModels"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Disabled"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════
             GLOBAL SCROLLVIEWER & DATAGRID SCROLLBAR OVERRIDES
             ══════════════════════════════════════════════════════════ -->
        <Style TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             MINIMAL SOFT PINK (LIGHT MODE) PALETTE & RESOURCES
             ══════════════════════════════════════════════════════════ -->
        <!-- Theme Colors -->
        <SolidColorBrush x:Key="LtBg"           Color="#F4F7FA"/>
        <SolidColorBrush x:Key="LtCard"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LtCard2"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LtBorder"       Color="#E2E8F0"/>
        <SolidColorBrush x:Key="LtText"         Color="#0F172A"/>
        <SolidColorBrush x:Key="LtMuted"        Color="#475569"/>
        <SolidColorBrush x:Key="LtPinkAccent"   Color="#00A3E0"/>
        <SolidColorBrush x:Key="LtPinkHover"    Color="#0B2545"/>
        <SolidColorBrush x:Key="LtCyanAccent"   Color="#0284C7"/>
        <SolidColorBrush x:Key="LtGreenAccent"  Color="#15803D"/>
        <SolidColorBrush x:Key="LtAmberAccent"  Color="#B45309"/>
        <SolidColorBrush x:Key="LtRedAccent"    Color="#0B2545"/>

        <!-- Legacy / Fallback Color Key Mappings for Compatibility -->
        <SolidColorBrush x:Key="DkBg"       Color="#F4F7FA"/>
        <SolidColorBrush x:Key="DkCard"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DkCard2"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DkBorder"   Color="#E2E8F0"/>
        <SolidColorBrush x:Key="DkText"     Color="#0F172A"/>
        <SolidColorBrush x:Key="DkMuted"    Color="#475569"/>
        <SolidColorBrush x:Key="DkPurple"   Color="#00A3E0"/>
        <SolidColorBrush x:Key="DkCyan"     Color="#0284C7"/>
        <SolidColorBrush x:Key="DkGreen"    Color="#15803D"/>
        <SolidColorBrush x:Key="DkRed"      Color="#0B2545"/>
        <SolidColorBrush x:Key="DkAmber"    Color="#B45309"/>

        <!-- Stat Card Background Brushes -->
        <SolidColorBrush x:Key="CardPurple" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardCyan"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardGreen"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardAmber"  Color="#FFFFFF"/>

        <!-- Base Styles -->
        <Style x:Key="DkTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LtText}"/>
            <Setter Property="FontFamily" Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="CornerRadius"      Value="12"/>
            <Setter Property="Padding"           Value="18,14"/>
            <Setter Property="Margin"            Value="0,0,12,0"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="BorderBrush"       Value="{StaticResource LtBorder}"/>
            <Setter Property="Background"        Value="#FFFFFF"/>
            <Setter Property="Effect"            Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource LtCard}"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource LtBorder}"/>
            <Setter Property="Effect"          Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- DataGrid Styling -->
        <Style x:Key="DkDataGrid" TargetType="DataGrid">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="GridLinesVisibility"    Value="None"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility"   Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Disabled"/>
            <Setter Property="RowBackground"          Value="Transparent"/>
            <Setter Property="AutoGenerateColumns"    Value="False"/>
            <Setter Property="CanUserAddRows"         Value="False"/>
            <Setter Property="IsReadOnly"             Value="True"/>
            <Setter Property="HeadersVisibility"      Value="Column"/>
            <Setter Property="SelectionMode"          Value="Single"/>
            <Setter Property="FontFamily"             Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground"       Value="{StaticResource LtText}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="10,6"/>
            <Setter Property="FontSize"         Value="16"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="FontFamily"       Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════
         ROOT GRID (No ScrollViewer Wrapper — Proportional Rows)
         ══════════════════════════════════════════════════════════ -->
    <Grid Background="#E0F2FE"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">

        <Grid Margin="20,16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Row 0: Header -->
                <RowDefinition Height="12"/>    <!-- Row 1: gap -->
                <RowDefinition Height="Auto"/>  <!-- Row 2: Stat Cards -->
                <RowDefinition Height="12"/>    <!-- Row 3: gap -->
                <RowDefinition Height="1.2*"/>  <!-- Row 4: Charts (Proportional Height) -->
                <RowDefinition Height="12"/>    <!-- Row 5: gap -->
                <RowDefinition Height="1*"/>    <!-- Row 6: Bottom Tables (Proportional Height) -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════
                 ROW 0 — HEADER
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ภาพรวมร้านค้า"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource LtText}"
                               FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                    <TextBlock Text="ยินดีต้อนรับสู่ระบบบริหารจัดการร้าน พอใจ ทุกอย่าง 20 บาท"
                               FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource LtMuted}"
                               FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════
                 ROW 2 — STAT CARDS
                 ══════════════════════════════════════════ -->
            <UniformGrid Grid.Row="2" Columns="4" Rows="1">

                <!-- Card 1: ยอดขายวันนี้ -->
                <Border Style="{StaticResource StatCard}" Background="{StaticResource CardPurple}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ยอดขายวันนี้" FontSize="13" Foreground="{StaticResource LtMuted}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#00A3E0" CornerRadius="8" Width="28" Height="28" HorizontalAlignment="Right">
                                <TextBlock Text="&#xE1FA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding TodaySales}" FontSize="36" FontWeight="ExtraBold" Foreground="#0B2545" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="{Binding TodaySalesArrow}" FontSize="14" Foreground="{Binding TodaySalesColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TodaySalesChange}" FontSize="13" FontWeight="Bold" Foreground="{Binding TodaySalesColor}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: คำสั่งซื้อวันนี้ -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="คำสั่งซื้อวันนี้" FontSize="15" FontWeight="Bold" Foreground="{StaticResource LtMuted}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#0284C7" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Right">
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding TodayOrders}" FontSize="36" FontWeight="ExtraBold" Foreground="#0B2545" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="{Binding TodayOrdersArrow}" FontSize="14" Foreground="{Binding TodayOrdersColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TodayOrdersChange}" FontSize="13" FontWeight="Bold" Foreground="{Binding TodayOrdersColor}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: สินค้าคงคลัง -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="สินค้าคงคลัง" FontSize="15" FontWeight="Bold" Foreground="{StaticResource LtMuted}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#15803D" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Right">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding TodayStock}" FontSize="36" FontWeight="ExtraBold" Foreground="#0B2545" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="{Binding TodayStockArrow}" FontSize="14" Foreground="{Binding TodayStockColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TodayStockChange}" FontSize="13" FontWeight="Bold" Foreground="{Binding TodayStockColor}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: ลูกค้าใหม่ -->
                <Border Style="{StaticResource StatCard}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ลูกค้าใหม่" FontSize="15" FontWeight="Bold" Foreground="{StaticResource LtMuted}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#B45309" CornerRadius="8" Width="32" Height="32" HorizontalAlignment="Right">
                                <TextBlock Text="&#xE136;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding NewCustomers}" FontSize="36" FontWeight="ExtraBold" Foreground="#0B2545" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                            <TextBlock Text="{Binding NewCustomersArrow}" FontSize="12" Foreground="{Binding NewCustomersColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NewCustomersChange}" FontSize="11" Foreground="{Binding NewCustomersColor}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════════
                 ROW 4 — CHARTS (Proportional Height="1.2*")
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="4" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="38*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Line Chart — Monthly Sales -->
                <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ยอดขายรายเดือน" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LtText}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                <TextBlock Text="ปี 2026" FontSize="11" Foreground="{StaticResource LtMuted}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource LtPinkAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="รายรับ" FontSize="11" Foreground="{StaticResource LtMuted}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource LtCyanAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ยอดสุทธิ" FontSize="11" Foreground="{StaticResource LtMuted}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <lvc:CartesianChart Grid.Row="1" Series="{Binding MonthlySalesSeries}" LegendLocation="None" AnimationsSpeed="0:0:0.6" Hoverable="True" DataTooltip="{x:Null}">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding MonthLabels}" Foreground="#718096" FontSize="11">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" StrokeThickness="0"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding MoneyFormatter}" Foreground="#718096" FontSize="11" MinValue="0">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Stroke="#BAE6FD" StrokeThickness="1"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                            <lvc:CartesianChart.Background>
                                <SolidColorBrush Color="#FFFFFF"/>
                            </lvc:CartesianChart.Background>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <!-- RIGHT: Bar Chart — Weekly Sales -->
                <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ยอดขายสัปดาห์นี้" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LtText}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                <TextBlock Text="11–17 ก.ค. 2026" FontSize="11" Foreground="{StaticResource LtMuted}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="↗" FontSize="16" Foreground="{StaticResource LtPinkAccent}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <lvc:CartesianChart Grid.Row="1" Series="{Binding WeeklySalesSeries}" LegendLocation="None" AnimationsSpeed="0:0:0.6" Hoverable="True" DataTooltip="{x:Null}">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding DayLabels}" Foreground="#718096" FontSize="11">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" StrokeThickness="0"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding ShortMoneyFormatter}" Foreground="#718096" FontSize="11" MinValue="0">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Stroke="#BAE6FD" StrokeThickness="1"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                            <lvc:CartesianChart.Background>
                                <SolidColorBrush Color="#FFFFFF"/>
                            </lvc:CartesianChart.Background>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════
                 ROW 6 — BOTTOM: Recent Orders + Top Products (Height="1*")
                 ══════════════════════════════════════════ -->
            <Grid Grid.Row="6" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="45*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Recent Orders -->
                <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="คำสั่งซื้อล่าสุด" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LtText}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                            <Button DockPanel.Dock="Right" Command="{Binding GoToSalesHistoryCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="ดูทั้งหมด ›" FontSize="12" Foreground="{StaticResource LtPinkAccent}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding RecentOrders}"
                                  Style="{StaticResource DkDataGrid}"
                                  RowHeight="36"
                                  HeadersVisibility="Column"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">

                                  <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" 
                                                              Foreground="#000000" 
                                                              FontSize="16" 
                                                              FontWeight="Bold" 
                                                              HorizontalAlignment="Center"
                                                              FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <!-- 1. ออเดอร์: ขยายเป็น 130 เพื่อเว้นระยะจากชื่อลูกค้า และจัดกึ่งกลาง -->
                                    <DataGridTextColumn Header="ออเดอร์" 
                                                        Binding="{Binding OrderId}" 
                                                        Width="130" 
                                                        CanUserReorder="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontFamily" Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 2. ลูกค้า: จัดกึ่งกลาง และขยายเต็มพื้นที่ส่วนที่เหลือ -->
                                    <DataGridTextColumn Header="ลูกค้า" 
                                                        Binding="{Binding Customer}" 
                                                        Width="*" 
                                                        CanUserReorder="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontFamily" Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 3. ประเภทการซื้อ: ปรับความกว้างเป็น 120 และจัดกึ่งกลาง -->
                                    <DataGridTextColumn Header="ประเภทการซื้อ" 
                                                        Binding="{Binding PurchaseType}" 
                                                        Width="120" 
                                                        CanUserReorder="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontFamily" Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 4. รายการ: ขยายเป็น 85 ให้ได้สัดส่วนกับหัวตาราง และจัดกึ่งกลาง -->
                                    <DataGridTextColumn Header="รายการ" 
                                                        Binding="{Binding Items}" 
                                                        Width="85" 
                                                        CanUserReorder="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontFamily" Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 5. ยอดรวม: ขยายเป็น 100 และจัดกึ่งกลาง -->
                                    <DataGridTextColumn Header="ยอดรวม" 
                                                        Binding="{Binding Total}" 
                                                        Width="100" 
                                                        CanUserReorder="False">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontFamily" Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 6. สถานะ: ขยายเป็น 80 (กึ่งกลางอยู่แล้วใน CellTemplate) -->
                                    <DataGridTemplateColumn Header="สถานะ" 
                                                            Width="80" 
                                                            CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EDF2F7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="รอดำเนินการ">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="รอจัดส่ง">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="จัดส่งสำเร็จ">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="เคลมสำเร็จ">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="สำเร็จ">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="ยกเลิกรายการ">
                                                                    <Setter Property="Background" Value="#E0F2FE"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#4A5568"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="รอดำเนินการ">
                                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="รอจัดส่ง">
                                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="จัดส่งสำเร็จ">
                                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="เคลมสำเร็จ">
                                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="สำเร็จ">
                                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="ยกเลิกรายการ">
                                                                        <Setter Property="Foreground" Value="#0082B3"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                    </Grid>
                </Border>

                <!-- RIGHT: Top Products -->
                <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="สินค้าขายดี" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LtText}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                            <Button DockPanel.Dock="Right" Command="{Binding GoToSalesHistoryCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="ดูทั้งหมด ›" FontSize="12" Foreground="{StaticResource LtPinkAccent}" FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DockPanel>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding TopProducts}"
                                  Style="{StaticResource DkDataGrid}"
                                  RowHeight="36"
                                  HeadersVisibility="Column"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#BAE6FD"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" 
                                                           Foreground="#000000" 
                                                           FontSize="16" 
                                                           FontWeight="Bold" 
                                                           HorizontalAlignment="Center"
                                                           FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"       Binding="{Binding Rank}"    Width="40"/>
                                <DataGridTextColumn Header="สินค้า"  Binding="{Binding Name}"    Width="*"/>
                                <DataGridTextColumn Header="ขายได้"  Binding="{Binding Sold}"    Width="80"/>
                                <DataGridTextColumn Header="รายรับ"  Binding="{Binding Revenue}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>