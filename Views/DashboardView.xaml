<UserControl x:Class="Porjai20.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Porjai20.ViewModels"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="1280"
             Background="#F8FAFC"
             FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI, sans-serif">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Card Shadow -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Direction="270" Color="#64748B" Opacity="0.06"/>

        <!-- Outline Todo Action Button Style (พื้นหลังขาว ขอบฟ้า #0284C7 ตัวหนังสือ #0F172A) -->
        <Style x:Key="TodoActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F9FF"/>
                                <Setter Property="BorderBrush" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Sky Blue Action Button Style (สีฟ้าสดใสเดิม #0284C7) -->
        <Style x:Key="SkyActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline To-Do Button Style (Ghost / Outline Style for To-Do List) -->
        <Style x:Key="OutlineTodoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding Tag}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Header Text Link Button Style (Sky-600 #0284C7 with hover underline) -->
        <Style x:Key="CardHeaderLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock FontSize="{TemplateBinding FontSize}" 
                                   FontWeight="{TemplateBinding FontWeight}" 
                                   Foreground="{TemplateBinding Foreground}" 
                                   Text="{TemplateBinding Content}" 
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                            <Setter Property="Foreground" Value="#0369A1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Link Button Style alias -->
        <Style x:Key="HeaderLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource CardHeaderLinkButtonStyle}"/>

        <!-- Link Button Style -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="tb" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean DataGrid Header Style -->
        <Style x:Key="CleanHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>

        <!-- Clean DataGrid Cell Style -->
        <Style x:Key="CleanCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0F9FF"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean DataGrid Row Style -->
        <Style x:Key="CleanRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0F9FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean DataGrid Style -->
        <Style x:Key="CleanDataGrid" TargetType="DataGrid">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource CleanHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource CleanCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource CleanRowStyle}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════
         SCROLLVIEWER (Mouse Wheel Scrolling with Hidden Scrollbar)
         ══════════════════════════════════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="True"
                  Focusable="False"
                  Background="#E0F2FE">

        <Grid Margin="24,20" MaxWidth="1400" HorizontalAlignment="Stretch" Background="#E0F2FE">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="0*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Row 0: Header -->
                <RowDefinition Height="18"/>
                <!-- Gap -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: 4 KPI Cards -->
                <RowDefinition Height="18"/>
                <!-- Gap -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: Row 2 (Tasks vs Hourly Chart) -->
                <RowDefinition Height="18"/>
                <!-- Gap -->
                <RowDefinition Height="Auto"/>
                <!-- Row 6: Row 3 (Customer / Recent Bills / Best Sellers) -->
                <RowDefinition Height="288.433"/>
                <RowDefinition Height="186.703"/>
                <!-- Bottom padding gap -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 0: HEADER
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title, Dynamic Thai Date, Status Badge -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="สรุปวันนี้" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="#0F172A"/>

                        <!-- Store Open Status Badge -->
                        <Border Background="#DCFCE7" 
                                CornerRadius="12" 
                                Padding="10,4" 
                                Margin="14,0,0,0" 
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="ร้านเปิดอยู่" FontSize="13" FontWeight="Bold" Foreground="#16A34A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Dynamic Current Thai Date -->
                    <TextBlock Text="{Binding CurrentDateThai}" 
                               FontSize="14" 
                               Foreground="#64748B" 
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Right: Shortcut Button [ ไปหน้าขาย ] (No Cart Icon, Height 40, CornerRadius 8) -->
                <Button Grid.Column="1" 
                        Content="ไปหน้าขาย" 
                        Command="{Binding NavigateToPOSCommand}" 
                        Background="#0284C7" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="15" 
                        Height="40" 
                        Padding="22,0" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#38BDF8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 2: 4 UNIFORM KPI CARDS
                 ══════════════════════════════════════════════════════════ -->
            <UniformGrid Grid.Row="1" Columns="4" Rows="1" Grid.ColumnSpan="3" Margin="0,18,0,18" Grid.RowSpan="3">

                <!-- Card 1: ยอดขายวันนี้ -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="ยอดขายวันนี้" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Width="38" Height="38" CornerRadius="8" Background="#E0F2FE">
                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Value with "บาท" Baseline Alignment -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding TodaySales}" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Bottom"/>
                            <TextBlock Text="บาท" FontSize="14" Foreground="#64748B" Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Yesterday Comparison Badge -->
                        <Border Grid.Row="4" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DCFCE7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSalesGrowthPositive}" Value="False">
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TodaySalesGrowthText}" FontSize="12" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#16A34A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSalesGrowthPositive}" Value="False">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: กำไรโดยประมาณ -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="กำไรโดยประมาณ" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Width="38" Height="38" CornerRadius="8" Background="#DCFCE7">
                                <TextBlock Text="&#xE1D1;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Value with "บาท" Baseline Alignment -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding EstimatedProfit}" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Bottom"/>
                            <TextBlock Text="บาท" FontSize="14" Foreground="#64748B" Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Sub-caption -->
                        <TextBlock Grid.Row="4" Text="คำนวณจากราคาต้นทุนของสินค้า" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Card 3: บิลวันนี้ -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,0,12,0" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="บิลวันนี้" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Width="38" Height="38" CornerRadius="8" Background="#F3E8FF">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#9333EA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Value with "บิล" Baseline Alignment -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding TodayBillsCount}" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Bottom"/>
                            <TextBlock Text="บิล" FontSize="14" Foreground="#64748B" Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Average per bill text -->
                        <TextBlock Grid.Row="4" Text="{Binding AveragePerBillText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Card 4: ยอดจากสมาชิก -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="ยอดจากสมาชิก" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Width="38" Height="38" CornerRadius="8" Background="#E0F2FE">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Value with "บาท" Baseline Alignment -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding MemberSalesToday}" FontSize="26" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Bottom"/>
                            <TextBlock Text="บาท" FontSize="14" Foreground="#64748B" Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Sub-caption: % of total sales -->
                        <TextBlock Grid.Row="4" Text="{Binding MemberSalesPercentText}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 4: ROW 2 (ต้องทำวันนี้ VS กราฟบิลรายชั่วโมง)
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,18" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="58*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: ต้องทำวันนี้ (Action Tasks - ด่วนขึ้นก่อนเสมอ + ปุ่มขอบฟ้าพื้นขาว) -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- Header: หัวข้อ + Badge วงกลมสมบูรณ์ -->
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A" Text="ต้องทำวันนี้"/>

                                <!-- Badge วงกลมสีแดง (Perfect Circle Width=Height=26, CornerRadius=13) -->
                                <Border Background="#EF4444" CornerRadius="13" Height="26" HorizontalAlignment="Center" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasAnyPendingTasks, Converter={StaticResource BooleanToVisibilityConverter}}" Width="26">
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Text="{Binding ActiveUrgentTasksCategoryCount}" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock FontSize="13" Foreground="#64748B" Margin="0,0,0,8" Text="งานจากระบบทั้งหมด เรียงตามความเร่งด่วน"/>

                        <!-- รายการงานค้างพร้อมเส้นคั่น -->
                        <StackPanel>

                            <!-- แถวที่ 1: สินค้าใกล้หมด / หมดสต็อก (มีเส้นคั่นล่าง) -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,14" Visibility="{Binding HasNeedReorder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FEE2E2" CornerRadius="8" Grid.Column="0" Height="40" Margin="0,0,12,0" Width="40">
                                        <TextBlock FontSize="18" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe MDL2 Assets, sans-serif" HorizontalAlignment="Center" Text="📥" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Text="สินค้าใกล้หมด / หมดสต็อก"/>
                                            <Border Background="#FEE2E2" CornerRadius="4" Margin="8,0,0,0" Padding="6,2">
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#DC2626" Text="ด่วน"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="13" Foreground="#64748B" Margin="0,3,0,0" Text="{Binding NeedReorderCount, StringFormat='{}{0} รายการ'}"/>
                                    </StackPanel>
                                    <Button Command="{Binding NavigateToPurchaseOrderCommand}" 
                                            Content="สั่งซื้อ" 
                                            Grid.Column="2" 
                                            Style="{StaticResource TodoActionButtonStyle}"/>
                                </Grid>
                            </Border>

                            <!-- แถวที่ 2: ด่วน: รายการเคลมสินค้า (มีเส้นคั่นล่าง) -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,14" Visibility="{Binding HasPendingClaim, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FEE2E2" CornerRadius="8" Grid.Column="0" Height="40" Margin="0,0,12,0" Width="40">
                                        <TextBlock FontSize="18" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe MDL2 Assets, sans-serif" HorizontalAlignment="Center" Text="🛡️" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Text="รายการเคลมสินค้า"/>
                                            <Border Background="#FEE2E2" CornerRadius="4" Margin="8,0,0,0" Padding="6,2">
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#DC2626" Text="ด่วน"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="13" Foreground="#64748B" Margin="0,3,0,0" Text="{Binding PendingClaimCount, StringFormat='{}{0} รายการ'}"/>
                                    </StackPanel>
                                    <Button Command="{Binding NavigateToClaimCommand}" 
                                            Content="จัดการเคลม" 
                                            Grid.Column="2" 
                                            Style="{StaticResource TodoActionButtonStyle}"/>
                                </Grid>
                            </Border>

                            <!-- แถวที่ 3: ออเดอร์รอจัดส่ง (มีเส้นคั่นล่าง) -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,14" Visibility="{Binding HasPendingDelivery, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- ไอคอนกล่องสีส้ม/เหลือง -->
                                    <Border Background="#FEF3C7" CornerRadius="8" Grid.Column="0" Height="40" Margin="0,0,12,0" Width="40">
                                        <TextBlock FontSize="18" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe MDL2 Assets, sans-serif" HorizontalAlignment="Center" Text="📦" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- ข้อความและ Badge -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Text="ออเดอร์รอจัดส่ง"/>
                                            <Border Background="#FEF3C7" CornerRadius="4" Margin="8,0,0,0" Padding="6,2">
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#D97706" Text="รอจัดส่ง"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="13" Foreground="#64748B" Margin="0,3,0,0" Text="{Binding PendingDeliveryCount, StringFormat='{}{0} รายการ'}"/>
                                    </StackPanel>
                                    <Button Command="{Binding NavigateToDeliveryCommand}" 
                                            Content="จัดส่ง" 
                                            Grid.Column="2" 
                                            Style="{StaticResource TodoActionButtonStyle}"/>
                                </Grid>
                            </Border>

                            <!-- แถวที่ 4: ใบสั่งซื้อรอรับของ (แถวล่างสุด ไม่มีเส้นคั่น BorderThickness="0") -->
                            <Border BorderThickness="0" Padding="0,14,0,4" Visibility="{Binding HasPendingReceive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- ไอคอนรับของสีเหลือง/ส้ม -->
                                    <Border Background="#FEF3C7" CornerRadius="8" Grid.Column="0" Height="40" Margin="0,0,12,0" Width="40">
                                        <TextBlock FontSize="18" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe MDL2 Assets, sans-serif" HorizontalAlignment="Center" Text="📋" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Text="ใบสั่งซื้อรอรับของ"/>
                                            <Border Background="#FEF3C7" CornerRadius="4" Margin="8,0,0,0" Padding="6,2">
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#D97706" Text="รอรับของ"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock FontSize="13" Foreground="#64748B" Margin="0,3,0,0" Text="{Binding PendingReceiveCount, StringFormat='{}{0} ใบ'}"/>
                                    </StackPanel>
                                    <Button Command="{Binding NavigateToStockInCommand}" 
                                            Content="ตรวจรับ" 
                                            Grid.Column="2" 
                                            Style="{StaticResource TodoActionButtonStyle}"/>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- Empty State: แสดงเมื่อไม่มีงานค้างเลยทั้ง 4 ด้าน -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnyPendingTasks}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" Text="✓"/>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" Text="ไม่มีงานค้างในระบบ ทุกอย่างเรียบร้อยดี"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- RIGHT: กราฟบิลรายชั่วโมง (วันนี้ เทียบ เมื่อวาน) -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Legend (ย้าย Legend วันนี้/เมื่อวาน ไปขวาสุด) -->
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                            <!-- ฝั่งซ้าย: หัวข้อกราฟ -->
                            <TextBlock DockPanel.Dock="Left" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Text="บิลรายชั่วโมง: วันนี้เทียบเมื่อวาน" VerticalAlignment="Center"/>

                            <!-- ฝั่งขวา: Legend สีประจำแท่งกราฟ -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- วันนี้ (จุดฟ้าเข้ม) -->
                                <Ellipse Fill="#0284C7" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Width="8"/>
                                <TextBlock FontSize="13" Foreground="#64748B" Margin="0,0,14,0" Text="วันนี้" VerticalAlignment="Center"/>
                                <!-- เมื่อวาน (จุดฟ้าอ่อน) -->
                                <Ellipse Fill="#BAE6FD" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Width="8"/>
                                <TextBlock FontSize="13" Foreground="#64748B" Text="เมื่อวาน" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Empty State when no bills today -->
                        <Border Grid.Row="1" 
                                Height="220" 
                                Background="#F8FAFC" 
                                CornerRadius="10" 
                                Margin="0,4,0,0" 
                                Padding="20"
                                Visibility="{Binding HasHourlyData, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="ยังไม่มีบิลวันนี้ กราฟจะเริ่มแสดงเมื่อมีรายการแรก" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- LiveCharts Cartesian Chart (Integer Y-Axis: 0, 1, 2, 3...) -->
                        <lvc:CartesianChart Grid.Row="1" 
                                            Height="220" 
                                            Series="{Binding HourlySalesSeries}" 
                                            LegendLocation="None" 
                                            AnimationsSpeed="0:0:0.5" 
                                            Hoverable="True" 
                                            DataTooltip="{x:Null}"
                                            Visibility="{Binding HasHourlyData, Converter={StaticResource BoolToVis}}">
                            <!-- X Axis: 08:00 - 21:00 -->
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Labels="{Binding HourlyLabels}" Foreground="#94A3B8" FontSize="12">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" StrokeThickness="0"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>

                            <!-- Y Axis: Strictly Integer Only, No Decimals -->
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis LabelFormatter="{Binding IntegerFormatter}" 
                                          MinValue="0" 
                                          MinRange="1"
                                          Foreground="#94A3B8" 
                                          FontSize="12">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" Stroke="#F1F5F9" StrokeThickness="1"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                            <lvc:CartesianChart.Background>
                                <SolidColorBrush Color="#FFFFFF"/>
                            </lvc:CartesianChart.Background>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 ROW 6: ROW 3 (3 COLUMNS: CUSTOMER / RECENT BILLS / BEST SELLERS)
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="6" Grid.ColumnSpan="3" Margin="0,0,0,12" Grid.RowSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="38*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="34*"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════════
                     COLUMN 1: สมาชิกวันนี้
                     ══════════════════════════════════════════ -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 2. หัวข้อการ์ด "สมาชิกวันนี้" -->
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Text="สมาชิกวันนี้" VerticalAlignment="Center"/>
                            <Button Command="{Binding NavigateToCustomerCommand}" Content="ดูสมาชิก →" DockPanel.Dock="Right" Style="{StaticResource CardHeaderLinkButtonStyle}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Member Statistics Items -->
                        <StackPanel Grid.Row="2">

                            <!-- แถวที่ 1: สมาชิกใหม่วันนี้ (Badge สีเขียวอ่อน) -->
                            <Border Background="#F8FAFC" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" FontSize="14" Foreground="#334155" Text="สมาชิกใหม่วันนี้" VerticalAlignment="Center"/>
                                    <Border Background="#DCFCE7" CornerRadius="6" DockPanel.Dock="Right" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#16A34A" Text="{Binding NewMembersTodayCount, StringFormat='{}{0} ท่าน'}"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <!-- แถวที่ 2: สมาชิกทั้งหมดในระบบ (Badge สีเทาอ่อน) -->
                            <Border Background="#F8FAFC" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" FontSize="14" Foreground="#334155" Text="สมาชิกทั้งหมดในระบบ" VerticalAlignment="Center"/>
                                    <Border Background="#F1F5F9" CornerRadius="6" DockPanel.Dock="Right" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#0F172A" Text="{Binding TotalMembersCount, StringFormat='{}{0} ท่าน'}"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <!-- แถวที่ 3: แต้มที่แจกวันนี้ (Badge สีฟ้าอ่อน) -->
                            <Border Background="#F8FAFC" CornerRadius="8" Margin="0,0,0,8" Padding="14,10">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" FontSize="14" Foreground="#334155" Text="แต้มที่แจกวันนี้" VerticalAlignment="Center"/>
                                    <Border Background="#E0F2FE" CornerRadius="6" DockPanel.Dock="Right" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#0284C7" Text="{Binding PointsGivenToday, StringFormat='{}{0} แต้ม'}"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <!-- แถวที่ 4: แต้มที่ถูกแลก (Badge สีเหลืองอ่อน) -->
                            <Border Background="#F8FAFC" CornerRadius="8" Margin="0,0,0,0" Padding="14,10">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" FontSize="14" Foreground="#334155" Text="แต้มที่ถูกแลก" VerticalAlignment="Center"/>
                                    <Border Background="#FEF3C7" CornerRadius="6" DockPanel.Dock="Right" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#D97706" Text="{Binding PointsRedeemedToday, StringFormat='{}{0} แต้ม'}"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════
                     COLUMN 2: บิลล่าสุด
                     ══════════════════════════════════════════ -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="18" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- 1. หัวข้อการ์ดและลิงก์ ดูทั้งหมด -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Text="บิลล่าสุด" VerticalAlignment="Center"/>
                            <Button Command="{Binding NavigateToSalesHistoryCommand}" Content="ดูทั้งหมด →" DockPanel.Dock="Right" Style="{StaticResource HeaderLinkButtonStyle}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- 2. หัวคอลัมน์ตาราง -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock FontSize="13" Foreground="#64748B" Grid.Column="0" Text="เลขที่ / เวลา"/>
                            <TextBlock FontSize="13" Foreground="#64748B" Grid.Column="1" Margin="8,0,0,0" Text="ลูกค้า"/>
                            <TextBlock FontSize="13" Foreground="#64748B" Grid.Column="2" HorizontalAlignment="Center" Text="รายการ"/>
                            <TextBlock FontSize="13" Foreground="#64748B" Grid.Column="3" HorizontalAlignment="Right" Text="ยอดรวม"/>
                        </Grid>

                        <!-- Empty State -->
                        <Border Height="200" 
                                Background="#F8FAFC" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,8,0,0"
                                Visibility="{Binding HasRecentBills, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="ยังไม่มีบิลขายในระบบ" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. รายการบิล 5 รายการล่าสุด -->
                        <ItemsControl ItemsSource="{Binding RecentBills}"
                                      Visibility="{Binding HasRecentBills, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="RecentBillRow_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- คอลัมน์ 0: เลขที่บิล / เวลา -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding RefNo}"/>
                                                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,3,0,0" Text="{Binding SalesTime, StringFormat='{}{0:HH:mm} น.'}"/>
                                            </StackPanel>

                                            <!-- คอลัมน์ 1: ชื่อลูกค้า / Badge สมาชิกด้านล่าง -->
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" Foreground="#0F172A" Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis"/>

                                                <!-- Badge แสดงสมาชิก -->
                                                <Border Background="#E0F2FE" CornerRadius="4" HorizontalAlignment="Left" Margin="0,3,0,0" Padding="6,1" Visibility="{Binding IsMember, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" Text="สมาชิก"/>
                                                </Border>

                                                <!-- Badge ลูกค้าทั่วไป (ถ้าไม่ใช่สมาชิก) -->
                                                <Border Background="#F1F5F9" CornerRadius="4" HorizontalAlignment="Left" Margin="0,3,0,0" Padding="6,1" Visibility="{Binding IsMember, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock FontSize="11" Foreground="#64748B" Text="ลูกค้าทั่วไป"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- คอลัมน์ 2: รายการ (จำนวนชิ้น) -->
                                            <TextBlock FontSize="13" Foreground="#0F172A" Grid.Column="2" HorizontalAlignment="Center" Text="{Binding TotalItems, StringFormat='{}{0} ชิ้น'}" VerticalAlignment="Center"/>

                                            <!-- คอลัมน์ 3: ยอดรวมตัวเลขล้วน ชิดขวา -->
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="#0F172A" Grid.Column="3" HorizontalAlignment="Right" Text="{Binding TotalAmount, StringFormat='{}{0:N2}'}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════
                     COLUMN 3: สินค้าขายดี (Top 3)
                     ══════════════════════════════════════════ -->
                <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Segmented Capsule Control (ย้ายชุดปุ่มเลือกช่วงเวลาไปขวาสุด) -->
                        <!-- 4. หัวข้อการ์ด "สินค้าขายดี" พร้อมแคปซูลสลับช่วงเวลา -->
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Text="สินค้าขายดี" VerticalAlignment="Center"/>

                            <!-- กรอบแคปซูลสีเทาอ่อน -->
                            <Border Background="#F1F5F9" CornerRadius="14" DockPanel.Dock="Right" Padding="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <!-- ปุ่ม วันนี้ -->
                                    <RadioButton Command="{Binding FilterTodayCommand}" Content="วันนี้" Cursor="Hand" GroupName="TopSellingFilter" IsChecked="{Binding IsTodayFilterSelected, Mode=TwoWay}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border Background="Transparent" CornerRadius="12" Padding="14,4" x:Name="bdr">
                                                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="#64748B" Text="{TemplateBinding Content}" x:Name="txt"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter Property="Background" TargetName="bdr" Value="#0F172A"/>
                                                                    <Setter Property="Foreground" TargetName="txt" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" TargetName="txt" Value="Bold"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>

                                    <!-- ปุ่ม 7 วัน -->
                                    <RadioButton Command="{Binding FilterWeekCommand}" Content="7 วัน" Cursor="Hand" GroupName="TopSellingFilter" IsChecked="{Binding IsWeekFilterSelected, Mode=TwoWay}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border Background="Transparent" CornerRadius="12" Padding="14,4" x:Name="bdr">
                                                                <TextBlock FontSize="13" FontWeight="Medium" Foreground="#64748B" Text="{TemplateBinding Content}" x:Name="txt"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter Property="Background" TargetName="bdr" Value="#0F172A"/>
                                                                    <Setter Property="Foreground" TargetName="txt" Value="#FFFFFF"/>
                                                                    <Setter Property="FontWeight" TargetName="txt" Value="Bold"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Empty State -->
                        <Border Grid.Row="2" 
                                Height="220" 
                                Background="#F8FAFC" 
                                CornerRadius="10" 
                                Padding="20" 
                                Visibility="{Binding HasTopSellingProducts, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="ยังไม่มีข้อมูลสินค้าขายดี" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Top 5 Products List -->
                        <ItemsControl Grid.Row="2" 
                                      ItemsSource="{Binding TopSellingProducts}"
                                      Visibility="{Binding HasTopSellingProducts, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="2,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="95"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Rank Circle -->
                                            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                <Setter Property="Background" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Rank}" Value="2">
                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Rank}" Value="3">
                                                                <Setter Property="Background" Value="#D97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Rank}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rank}" Value="2">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rank}" Value="3">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Product Name & Category -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,6,0">
                                                <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Quantity Sold -->
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding QuantitySold, StringFormat='{}{0} ชิ้น'}" 
                                                       FontSize="12" 
                                                       Foreground="#64748B" 
                                                       VerticalAlignment="Center" 
                                                       HorizontalAlignment="Center"/>

                                            <!-- Revenue (Right-Aligned) -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedTotal}" 
                                                           FontSize="13" 
                                                           FontWeight="Bold" 
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text=" บาท" 
                                                           FontSize="11" 
                                                           Foreground="#64748B" 
                                                           VerticalAlignment="Bottom" 
                                                           Margin="2,0,0,1"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>