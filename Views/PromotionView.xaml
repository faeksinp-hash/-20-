<UserControl x:Class="Porjai20.Views.PromotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Porjai20.ViewModels"
             xmlns:views="clr-namespace:Porjai20.Views"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1280"
             FontFamily="Noto Sans Thai, Noto Sans Thai Light, Segoe UI, sans-serif"
             Background="#F4F7FB">

    <UserControl.Resources>
        <!-- Soft Shadow for Cards -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0B2545" Opacity="0.08"/>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  MODERN TOGGLE SWITCH STYLE (ตามสเปกสวิตช์เปิด-ปิด)             -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Capsule Track -->
                                <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                        Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1.5">
                                    <Grid>
                                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#64748B"
                                                 HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- Status Label Text -->
                                <TextBlock x:Name="StatusLabel" Text="{Binding SwitchNote}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#DCFCE7"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#86EFAC"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#15803D"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FECACA"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#DC2626"/>
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#DC2626"/>
                                <Setter TargetName="StatusLabel" Property="Text" Value="ปิดอัตโนมัติ"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (+ สร้างโปรโมชั่นใหม่) -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (ปิด, ล้าง) -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Duplicate Soft Button -->
        <Style x:Key="CardDuplicateBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button (ลบ) -->
        <Style x:Key="DangerBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#0284C7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  SCREEN 2: CREATE / EDIT SUBVIEW (เมื่อ IsCreateEditMode == true) -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <views:PromotionCreateEditView DataContext="{Binding CreateEditVM}"
                                       Visibility="{Binding DataContext.IsCreateEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  SCREEN 1: PROMOTION CATALOG & DETAILS (เมื่อ IsCatalogMode == true) -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Margin="24,20" Visibility="{Binding IsCatalogMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <!-- 0: Header Section -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Spacing -->
                <RowDefinition Height="18"/>
                <!-- 2: 2-Column Content Area (Catalog Grid + Detail Panel) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  1. HEADER SECTION (หัวข้อหน้าจอ + BADGES สรุปสถานะ 3 แคปซูล)    -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <!-- Left: Title & Subtitle -->
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#E0F2FE" Margin="0,0,10,0">
                            <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="จัดการโปรโมชั่น" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="สร้าง แก้ไข และกำหนดเงื่อนไขส่วนลดของร้านพอใจ" FontSize="14" Foreground="#64748B" Margin="44,2,0,0"/>
                </StackPanel>

                <!-- Right: Status Summary Badges (3 แคปซูลมน) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Badge 1: ใช้งานอยู่ (สีเขียว: พื้นหลัง #DCFCE7, ตัวหนังสือ #16A34A) -->
                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="16" Padding="14,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,8,0"/>
                            <TextBlock Text="ใช้งานอยู่ " FontSize="13" FontWeight="SemiBold" Foreground="#16A34A"/>
                            <TextBlock Text="{Binding ActiveCount}" FontSize="13" FontWeight="Bold" Foreground="#16A34A"/>
                            <TextBlock Text=" รายการ" FontSize="13" FontWeight="SemiBold" Foreground="#16A34A"/>
                        </StackPanel>
                    </Border>

                    <!-- Badge 2: ฉบับร่าง (สีฟ้าเทา: พื้นหลัง #F1F5F9, ตัวหนังสือ #475569) -->
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="14,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#475569" Margin="0,0,8,0"/>
                            <TextBlock Text="ฉบับร่าง " FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text="{Binding DraftCount}" FontSize="13" FontWeight="Bold" Foreground="#475569"/>
                            <TextBlock Text=" รายการ" FontSize="13" FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>
                    </Border>

                    <!-- Badge 3: หมดอายุ (สีแดงอ่อน: พื้นหลัง #FEE2E2, ตัวหนังสือ #DC2626) -->
                    <Border Background="#FEE2E2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="16" Padding="14,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#DC2626" Margin="0,0,8,0"/>
                            <TextBlock Text="หมดอายุ " FontSize="13" FontWeight="SemiBold" Foreground="#DC2626"/>
                            <TextBlock Text="{Binding ExpiredCount}" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                            <TextBlock Text=" รายการ" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  2. TWO-COLUMN WORKSPACE                                   -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Left: Main Catalog (Width="*") -->
                    <ColumnDefinition Width="*"/>
                    <!-- Divider Spacing -->
                    <ColumnDefinition Width="20"/>
                    <!-- Right: Selected Promotion Detail Panel (Width="340") -->
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- ────────────────────────────────────────────────────── -->
                <!--  LEFT COLUMN: MAIN CATALOG (Toolbar, Chips, Grid)      -->
                <!-- ────────────────────────────────────────────────────── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <!-- 0: Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Filter Chips -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Cards Grid -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar: ช่องค้นหา + ปุ่มล้าง + ปุ่ม "+ สร้างโปรโมชั่นใหม่" -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ช่องค้นหา: Instant Search -->
                        <Border Grid.Column="0" Height="42" Margin="0,0,10,0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="SearchBox"
                                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}" FontSize="14" VerticalAlignment="Center"/>
                                <!-- Placeholder -->
                                <TextBlock Grid.Column="1" Text="ค้นหาชื่อหรือรหัสโปรโมชั่น..."
                                           Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- ปุ่มล้าง -->
                        <Button Grid.Column="1" Content="ล้าง" Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource SecondaryBtnStyle}" Height="42" Margin="0,0,12,0"/>

                        <!-- ปุ่ม "+ สร้างโปรโมชั่นใหม่" -->
                        <Button Grid.Column="2" Style="{StaticResource PrimaryActionBtnStyle}"
                                Command="{Binding StartCreateNewCommand}" Height="42">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="➕" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="สร้างโปรโมชั่นใหม่" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Filter Chips: [ ทั้งหมด (N) ], [ ลด ], [ แลก ], [ แจก ], [ แถม ], [ หมดอายุ (N) ] -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <!-- Chip: ทั้งหมด -->
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="ALL" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txt" Text="ทั้งหมด" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="cnt" Text="{Binding AllCount, StringFormat=' ({0})'}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAllSelected}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#38BDF8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFilterAllSelected}" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Chip: ลด (Discount) -->
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="Discount" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txt" Text="ลด" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="cnt" Text="{Binding DiscountCount, StringFormat=' ({0})'}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterDiscountSelected}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#38BDF8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFilterDiscountSelected}" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Chip: แลก (Redeem) -->
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="Redeem" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txt" Text="แลก" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="cnt" Text="{Binding RedeemCount, StringFormat=' ({0})'}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterRedeemSelected}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#38BDF8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFilterRedeemSelected}" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Chip: แจก (Gift) -->
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="Gift" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txt" Text="แจก" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="cnt" Text="{Binding GiftCount, StringFormat=' ({0})'}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterGiftSelected}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#38BDF8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFilterGiftSelected}" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Chip: แถม (Freebie) -->
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="Freebie" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txt" Text="แถม" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="cnt" Text="{Binding FreebieCount, StringFormat=' ({0})'}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterFreebieSelected}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#38BDF8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFilterFreebieSelected}" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Chip: หมดอายุ (Expired) -->
                            <Button Command="{Binding SetFilterCommand}" CommandParameter="Expired" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txt" Text="หมดอายุ" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="cnt" Text="{Binding ExpiredCount, StringFormat=' ({0})'}" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterExpiredSelected}" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#F87171"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFilterExpiredSelected}" Value="False">
                                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                                <Setter TargetName="cnt" Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Cards Grid: UniformGrid 3 คอลัมน์ ครอบด้วย ScrollViewer แบบซ่อน Scrollbar -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding FilteredPromotions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border VerticalAlignment="Top" CornerRadius="12" Padding="14" Margin="0,0,12,14"
                                                Effect="{StaticResource CardShadow}" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.SelectPromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>

                                            <!-- Card Style: White bg, rounded 12, dynamic blue border on selection -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#F0F9FF"/>
                                                            <Setter Property="BorderBrush" Value="#0284C7"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- 0: Card Top: Type badge & Status badge -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 1: Name & Code / Trigger -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 2: Condition Description -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 3: Scope line "ใช้กับ: ..." -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 4: Alert Banner if IsDraft -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 5: Footer Actions -->
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- 0. Card Top: Type Badge & Status Badge -->
                                                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                                                    <!-- Left: Type Badge: ลด (ฟ้าอ่อน), แลก (เหลืองส้ม), แจก (เขียวอ่อน), แถม (ม่วงอ่อน) -->
                                                    <Border DockPanel.Dock="Left" Background="{Binding PromoTypeBadgeBg}" BorderBrush="{Binding PromoTypeBadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="10,3">
                                                        <TextBlock Text="{Binding PromoTypeBadgeText}" FontSize="12" FontWeight="Bold" Foreground="{Binding PromoTypeBadgeFg}"/>
                                                    </Border>

                                                    <!-- Right: Status Badge: เปิดใช้งาน (เขียว), ฉบับร่าง (เทา), หมดอายุ (แดง) -->
                                                    <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeBg}" CornerRadius="12" Padding="8,3">
                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeFg}"/>
                                                    </Border>
                                                </DockPanel>

                                                <!-- 1. Promo Name & Code / Trigger -->
                                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding PromoName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding PromoName}"/>
                                                    <!-- รหัสโปรหรือการทำงาน -->
                                                    <TextBlock Text="{Binding CodeOrAutoText}" FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <!-- 2. Condition Description -->
                                                <TextBlock Grid.Row="2" Text="{Binding ConditionDescription}"
                                                           FontSize="13" Foreground="#475569" TextWrapping="Wrap"
                                                           MinHeight="36" Margin="0,0,0,8"/>

                                                <!-- 3. Target Scope "ใช้กับ: ..." -->
                                                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding TargetScopeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                                </Border>

                                                <!-- 4. Pastel Yellow Warning if IsDraft -->
                                                <Border Grid.Row="4" Background="#FEF9C3" BorderBrush="#FDE047" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,10"
                                                        Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚠️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="ต้องตั้งวันที่ใหม่ก่อนเปิดใช้งาน" FontSize="11" FontWeight="Bold" Foreground="#854D0E" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 5. Footer: [ ทำสำเนา ] ซ้าย, ModernToggleSwitch ขวา -->
                                                <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,2,0,0">
                                                    <!-- Left: Soft Button [ ทำสำเนา ] -->
                                                    <Button DockPanel.Dock="Left"
                                                            Style="{StaticResource CardDuplicateBtnStyle}"
                                                            Command="{Binding DataContext.DuplicatePromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="โคลนข้อมูลขึ้นมาเป็นการ์ดใหม่ในสถานะฉบับร่าง">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📋" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="ทำสำเนา" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Right: Toggle Switch (เปิดใช้งาน = สีเขียว / ปิดใช้งาน = สีเทา / หมดอายุ = ล็อก) -->
                                                    <ToggleButton DockPanel.Dock="Right"
                                                                  Style="{StaticResource ModernToggleSwitchStyle}"
                                                                  IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanToggleSwitch}"
                                                                  Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"
                                                                  VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty Search / Filter State -->
                            <Border Background="#FFFFFF" CornerRadius="12" Padding="40" Margin="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Visibility="{Binding FilteredPromotions.Count, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=0}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="ไม่พบโปรโมชั่นที่ตรงกับเงื่อนไข" FontSize="16" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    <TextBlock Text="ลองเปลี่ยนคำค้นหา หรือคลิกแท็บตัวกรอง 'ทั้งหมด' เพื่อดูรายการทั้งหมด" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                                    <Button Style="{StaticResource SecondaryBtnStyle}" Content="ดูโปรโมชั่นทั้งหมด" Height="38"
                                            Command="{Binding SetFilterCommand}" CommandParameter="ALL" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ────────────────────────────────────────────────────── -->
                <!--  RIGHT COLUMN: DETAIL PANEL (Width="340")              -->
                <!-- ────────────────────────────────────────────────────── -->
                <Grid Grid.Column="2">
                    <!-- สถานะว่างเมื่อไม่ได้เลือกโปรโมชั่น -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="12" Padding="24"
                            Visibility="{Binding HasSelectedPromotion, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#F1F5F9"
                                    BorderBrush="#E2E8F0" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🏷️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="กรุณาเลือกโปรโมชั่น" FontSize="17" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="คลิกเลือกการ์ดโปรโมชั่นทางซ้ายเพื่อดูรายละเอียดเงื่อนไขและสถิติ"
                                       FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- แผงแสดงข้อมูลโปรโมชั่นที่เลือกแบบ Read-Only -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="20"
                            BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}"
                            Visibility="{Binding HasSelectedPromotion, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Header: ป้ายประเภท + ชื่อโปรโมชั่น + "รายละเอียดโปรโมชั่น" -->
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <Border DockPanel.Dock="Left" Background="{Binding SelectedPromotion.PromoTypeBadgeBg}" BorderBrush="{Binding SelectedPromotion.PromoTypeBadgeBorder}" BorderThickness="1" CornerRadius="6" Padding="10,3">
                                        <TextBlock Text="{Binding SelectedPromotion.PromoTypeBadgeText}" FontSize="12" FontWeight="Bold" Foreground="{Binding SelectedPromotion.PromoTypeBadgeFg}"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="รายละเอียดโปรโมชั่น" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="{Binding SelectedPromotion.PromoName}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <!-- ไฮไลต์ประโยคสรุป (กรอบสีพาสเทลตามประเภท) -->
                                <Border Background="{Binding SelectedPromotion.PromoTypeBadgeBg}"
                                        BorderBrush="{Binding SelectedPromotion.PromoTypeBadgeBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding SelectedPromotion.HighlightSummary}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedPromotion.PromoTypeBadgeFg}" TextWrapping="Wrap" LineHeight="18"/>
                                </Border>

                                <!-- คุณสมบัติโปรโมชั่น (จัด 2 ฝั่ง) -->
                                <TextBlock Text="ข้อมูลและเงื่อนไข" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                    <StackPanel>
                                        <!-- ใช้กับสินค้า -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="ใช้กับสินค้า" FontSize="13" Foreground="#64748B" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding SelectedPromotion.TargetScopeDisplay}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Right" TextAlignment="Right"/>
                                        </DockPanel>

                                        <Rectangle Fill="#E2E8F0" Height="1" Margin="0,0,0,8"/>

                                        <!-- ลูกค้า -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="ลูกค้า" FontSize="13" Foreground="#64748B" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding SelectedPromotion.CustomerAudienceText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Right"/>
                                        </DockPanel>

                                        <Rectangle Fill="#E2E8F0" Height="1" Margin="0,0,0,8"/>

                                        <!-- ใช้ร่วมกับโปรอื่น -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="ใช้ร่วมกับโปรอื่น" FontSize="13" Foreground="#64748B" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding SelectedPromotion.CanCombineText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Right"/>
                                        </DockPanel>

                                        <Rectangle Fill="#E2E8F0" Height="1" Margin="0,0,0,8"/>

                                        <!-- ช่วงเวลา (วว/ดด/ปปปป) -->
                                        <DockPanel>
                                            <TextBlock Text="ช่วงเวลา" FontSize="13" Foreground="#64748B" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding SelectedPromotion.DateRangeDisplay}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- สรุปการใช้งาน (กรอบสีเทาอ่อน) -->
                                <TextBlock Text="สถิติการใช้งาน" FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="ใช้สิทธิ์ไปแล้ว" FontSize="13" Foreground="#64748B" DockPanel.Dock="Left"/>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <TextBlock Text="{Binding SelectedPromotion.CurrentUsage, StringFormat='{}{0:N0}'}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text=" ครั้ง" FontSize="12" Foreground="#64748B" VerticalAlignment="Bottom" Margin="3,0,0,1"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Rectangle Fill="#E2E8F0" Height="1" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="ของแถม/ของแจกที่ให้ไป" FontSize="13" Foreground="#64748B" DockPanel.Dock="Left"/>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <TextBlock Text="{Binding SelectedPromotion.CurrentUsage, StringFormat='{}{0:N0}'}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text=" ชิ้น" FontSize="12" Foreground="#64748B" VerticalAlignment="Bottom" Margin="3,0,0,1"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Rectangle Fill="#E2E8F0" Height="1" Margin="0,0,0,8"/>

                                        <!-- ต้นทุนของแถม (ห้ามมีสัญลักษณ์ ฿) -->
                                        <DockPanel>
                                            <TextBlock Text="ต้นทุนของแถม" FontSize="13" Foreground="#64748B" DockPanel.Dock="Left"/>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <TextBlock Text="{Binding SelectedPromotion.EstimatedCostFormatted}" FontSize="15" FontWeight="Bold" Foreground="#0284C7"/>
                                                <TextBlock Text=" บาท" FontSize="12" Foreground="#0284C7" VerticalAlignment="Bottom" Margin="3,0,0,1"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ชุดปุ่มท้ายแผง: [ ปิด ] คู่กับ [ แก้ไขโปรโมชั่น ] + [ ลบ ] -->
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ปุ่ม [ ปิด ] -->
                                        <Button Grid.Column="0" Content="ปิด"
                                                Style="{StaticResource SecondaryBtnStyle}"
                                                Command="{Binding CloseDetailsCommand}"/>

                                        <!-- ปุ่ม [ แก้ไขโปรโมชั่น ] -->
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryActionBtnStyle}"
                                                Command="{Binding StartEditCommand}"
                                                CommandParameter="{Binding SelectedPromotion}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✏️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="แก้ไขโปรโมชั่น" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- ปุ่ม [ ลบโปรโมชั่นนี้ ] -->
                                    <Button Style="{StaticResource DangerBtnStyle}"
                                            Command="{Binding DeletePromotionCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🗑️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ลบโปรโมชั่นนี้" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
