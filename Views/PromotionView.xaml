<UserControl x:Class="Porjai20.Views.PromotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Porjai20.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1280"
             FontFamily="Noto Sans Thai, Noto Sans Thai Light, Segoe UI, sans-serif"
             Background="#F4F7FB">

    <UserControl.Resources>
        <!-- Soft Shadow for Cards -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0B2545" Opacity="0.08"/>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  MODERN TOGGLE SWITCH STYLE (ตามสเปกสวิตช์เปิด-ปิด)             -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModernToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Capsule Track -->
                                <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                        Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1.5">
                                    <Grid>
                                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#64748B"
                                                 HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- Status Label Text -->
                                <TextBlock x:Name="StatusLabel" Text="ปิดใช้งาน"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#DCFCE7"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#86EFAC"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#15803D"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="StatusLabel" Property="Text" Value="เปิดใช้งาน"/>
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (+ สร้างโปรโมชั่นใหม่, บันทึกการแก้ไข) -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (ยกเลิก) -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button (ลบ / เก็บถาวร) -->
        <Style x:Key="DangerBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Small Action Button (แก้ไข, ทำสำเนา) -->
        <Style x:Key="CardActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F9FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#BAE6FD"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form Input Container Border Style -->
        <Style x:Key="FormInputContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <!-- Form TextBox Style -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#0284C7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Spacing -->
            <RowDefinition Height="18"/>
            <!-- 2: 2-Column Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  1. HEADER SECTION (หัวข้อหน้าจอ + BADGES สรุปสถานะ)         -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <!-- Left: Title & Subtitle -->
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Promo Tag Icon -->
                    <Border Width="34" Height="34" CornerRadius="8" Background="#E0F2FE" Margin="0,0,10,0">
                        <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="จัดการโปรโมชั่น" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="สร้าง แก้ไข และกำหนดเงื่อนไขส่วนลดของร้านพอใจ" FontSize="14" Foreground="#64748B" Margin="44,2,0,0"/>
            </StackPanel>

            <!-- Right: Status Summary Badges -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Active Badge (Green) -->
                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="16" Padding="14,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#15803D" Margin="0,0,8,0"/>
                        <TextBlock Text="ใช้งานอยู่ " FontSize="13" FontWeight="SemiBold" Foreground="#166534"/>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="13" FontWeight="Bold" Foreground="#166534"/>
                        <TextBlock Text=" รายการ" FontSize="13" FontWeight="SemiBold" Foreground="#166534"/>
                    </StackPanel>
                </Border>

                <!-- Expired Badge (Gray) -->
                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16" Padding="14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#64748B" Margin="0,0,8,0"/>
                        <TextBlock Text="หมดอายุ " FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ExpiredCount}" FontSize="13" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text=" รายการ" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  2. TWO-COLUMN MAIN WORKSPACE                              -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left: Main Catalog Area -->
                <ColumnDefinition Width="*"/>
                <!-- Divider Spacing -->
                <ColumnDefinition Width="20"/>
                <!-- Right: Edit Sidebar Form -->
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ────────────────────────────────────────────────────────── -->
            <!--  LEFT COLUMN: MAIN CATALOG AREA (Toolbar, Chips, Grid)     -->
            <!-- ────────────────────────────────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Toolbar (Search + New Button) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Filter Chips -->
                    <RowDefinition Height="Auto"/>
                    <!-- Promotion Cards Grid -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar: Search Box & "+ สร้างโปรโมชั่นใหม่" -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0" Height="42" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}" FontSize="14" VerticalAlignment="Center"/>

                            <!-- Watermark / Placeholder -->
                            <TextBlock Grid.Column="1" Text="ค้นหาจากรหัสโปรโมชั่น (Case-sensitive) เช่น FREESHIP, POINTS-50..."
                                       Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Button "+ สร้างโปรโมชั่นใหม่" -->
                    <Button Grid.Column="2" Style="{StaticResource PrimaryActionBtnStyle}"
                            Command="{Binding StartCreateNewCommand}" Height="42">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="➕" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="สร้างโปรโมชั่นใหม่" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Filter Chips Tab -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <!-- Chip 1: ทั้งหมด -->
                        <Button Command="{Binding SetFilterCommand}" CommandParameter="ALL" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="txt" Text="ทั้งหมด" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="cnt" Text="{Binding AllCount, StringFormat=' ({0})'}" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAllSelected}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                            <Setter TargetName="cnt" Property="Foreground" Value="#38BDF8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFilterAllSelected}" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                            <Setter TargetName="cnt" Property="Foreground" Value="#64748B"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip 2: ส่วนลดเงินสด -->
                        <Button Command="{Binding SetFilterCommand}" CommandParameter="CashDiscount" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="txt" Text="ส่วนลดเงินสด" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterCashDiscountSelected}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFilterCashDiscountSelected}" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip 3: สิทธิ์แลกแต้ม -->
                        <Button Command="{Binding SetFilterCommand}" CommandParameter="PointRedeem" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="txt" Text="สิทธิ์แลกแต้ม" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterPointRedeemSelected}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFilterPointRedeemSelected}" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip 4: คูปอง & ส่งฟรี -->
                        <Button Command="{Binding SetFilterCommand}" CommandParameter="FreeDelivery" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="txt" Text="คูปอง &amp; ส่งฟรี" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterFreeDeliverySelected}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFilterFreeDeliverySelected}" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Chip 5: หมดอายุ -->
                        <Button Command="{Binding SetFilterCommand}" CommandParameter="Expired" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="20" Padding="16,7" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="txt" Text="หมดอายุ" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="cnt" Text="{Binding ExpiredCount, StringFormat=' ({0})'}" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterExpiredSelected}" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#0F172A"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                            <Setter TargetName="cnt" Property="Foreground" Value="#F87171"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFilterExpiredSelected}" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#475569"/>
                                            <Setter TargetName="cnt" Property="Foreground" Value="#64748B"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Promotion Cards Grid (ItemsControl / UniformGrid 3 คอลัมน์) -->
                <ScrollViewer Grid.Row="2"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True">
                    <Grid>
                        <!-- Cards View -->
                        <ItemsControl ItemsSource="{Binding FilteredPromotions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border VerticalAlignment="Top"
                                            CornerRadius="12" Padding="14,16" Margin="0,0,12,12" Effect="{StaticResource CardShadow}" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.SelectPromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>

                                        <!-- Dynamic Border & Background depending on selection -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#F0F9FF"/>
                                                        <Setter Property="BorderBrush" Value="#0284C7"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- Card Header -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Condition Text -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Summary Box (2 Cols) -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Footer Actions -->
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 1. Card Header -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Tag Icon in Blue -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#E0F2FE" Margin="0,0,10,0">
                                                    <TextBlock Text="🏷️" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Promo Name + Promo ID badge -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PromoName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding PromoName}"/>
                                                    <Border Background="#E0F2FE" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding PromoID}" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Status Badge (เปิดใช้งาน / หมดอายุ / ปิดใช้งาน) -->
                                                <Border Grid.Column="2" Background="{Binding StatusBadgeBg}" CornerRadius="12" Padding="8,3" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeFg}"/>
                                                </Border>
                                            </Grid>

                                            <!-- 2. Condition Text -->
                                            <TextBlock Grid.Row="1" Text="{Binding ConditionDescription}"
                                                       FontSize="13" Foreground="#64748B"
                                                       TextWrapping="Wrap" Margin="0,10,0,10" MinHeight="36"/>

                                            <!-- 3. Summary Box: 2 Columns (ขั้นต่ำ: XX | ส่วนลด: YY สีฟ้าเด่นชัด) -->
                                            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Min Spend -->
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                        <TextBlock Text="ขั้นต่ำ" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding MinSpendFormatted}" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                            <TextBlock Text=" บาท" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Vertical Separator -->
                                                    <Rectangle Grid.Column="1" Fill="#E2E8F0" Margin="0,2"/>

                                                    <!-- Right: Discount Amount -->
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                        <TextBlock Text="ส่วนลด" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding DiscountAmountFormatted}" FontSize="18" FontWeight="Bold" Foreground="#0284C7"/>
                                                            <TextBlock Text=" บาท" FontSize="11" Foreground="#0284C7" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 4. Footer: [ แก้ไข ], [ ทำสำเนา ], ToggleButton สลับสถานะเปิด-ปิด -->
                                            <DockPanel Grid.Row="3" LastChildFill="False">
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Button แก้ไข -->
                                                    <Button Style="{StaticResource CardActionBtnStyle}"
                                                            Command="{Binding DataContext.SelectPromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,6,0" ToolTip="แก้ไขโปรโมชั่น">
                                                        <TextBlock Text="แก้ไข" FontSize="12"/>
                                                    </Button>

                                                    <!-- Button ทำสำเนา -->
                                                    <Button Style="{StaticResource CardActionBtnStyle}"
                                                            Command="{Binding DataContext.DuplicatePromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="คัดลอกโปรโมชั่นนี้">
                                                        <TextBlock Text="ทำสำเนา" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>

                                                <!-- ToggleButton ModernToggleSwitchStyle -->
                                                <ToggleButton DockPanel.Dock="Right"
                                                              Style="{StaticResource ModernToggleSwitchStyle}"
                                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                              Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"
                                                              VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty Search Placeholder -->
                        <Border Background="#FFFFFF" CornerRadius="12" Padding="40" Margin="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="1"
                                HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                Visibility="{Binding FilteredPromotions.Count, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=0}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="ไม่พบโปรโมชั่นที่ตรงกับเงื่อนไข" FontSize="16" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                <TextBlock Text="ลองเปลี่ยนคำค้นหา หรือคลิกแท็บตัวกรอง 'ทั้งหมด' เพื่อดูรายการทั้งหมด" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                                <Button Style="{StaticResource SecondaryBtnStyle}" Content="ดูโปรโมชั่นทั้งหมด" Height="38"
                                        Command="{Binding SetFilterCommand}" CommandParameter="ALL" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ────────────────────────────────────────────────────────── -->
            <!--  RIGHT COLUMN: EDIT SIDEBAR FORM (Width="340")            -->
            <!-- ────────────────────────────────────────────────────────── -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="20"
                    BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True">
                    <StackPanel>
                        <!-- Form Header -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{Binding FormHeaderTitle}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="กำหนดเงื่อนไขส่วนลดและระยะเวลา" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Separator -->
                        <Rectangle Fill="#E2E8F0" Height="1" Margin="0,0,0,16"/>

                        <!-- Field 1: รหัสโปรโมชั่น (Promo Code) -->
                        <TextBlock Text="รหัสโปรโมชั่น" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource FormInputContainerStyle}" Margin="0,0,0,14">
                            <TextBox Text="{Binding EditModel.PromoID, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="{Binding IsPromoIdReadOnly}"/>
                        </Border>

                        <!-- Field 2: ชื่อโปรโมชั่น (Promo Name) -->
                        <TextBlock Text="ชื่อโปรโมชั่น" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource FormInputContainerStyle}" Margin="0,0,0,14">
                            <TextBox Text="{Binding EditModel.PromoName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </Border>

                        <!-- Field 3: ประเภทโปรโมชั่น (Promo Type) -->
                        <TextBlock Text="ประเภทโปรโมชั่น" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="44" Margin="0,0,0,14">
                            <ComboBox SelectedValue="{Binding EditModel.PromoType, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource LightComboBoxStyle}"
                                      BorderThickness="0" Background="Transparent"
                                      Height="42" FontSize="15" VerticalContentAlignment="Center" Padding="8,0">
                                <ComboBoxItem Content="ส่วนลดเงินสด" Tag="CashDiscount"/>
                                <ComboBoxItem Content="สิทธิ์แลกแต้ม" Tag="PointRedeem"/>
                                <ComboBoxItem Content="คูปอง &amp; ส่งฟรี" Tag="FreeDelivery"/>
                            </ComboBox>
                        </Border>

                        <!-- Field 4: 2 คอลัมน์ (มูลค่าส่วนลด vs ยอดซื้อขั้นต่ำ) -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: มูลค่าส่วนลด (บาท) -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="มูลค่าส่วนลด (บาท)" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource FormInputContainerStyle}">
                                    <TextBox Text="{Binding EditModel.DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Column 1: ยอดซื้อขั้นต่ำ (บาท) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ยอดขั้นต่ำ (บาท)" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource FormInputContainerStyle}">
                                    <TextBox Text="{Binding EditModel.MinSpend, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Field 5: แต้มสะสมที่ต้องใช้ (แสดงเฉพาะประเภท PointRedeem) -->
                        <StackPanel Visibility="{Binding EditModel.IsPointRedeem, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                            <TextBlock Text="แต้มสะสมที่ต้องใช้ (แต้ม)" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource FormInputContainerStyle}">
                                <TextBox Text="{Binding EditModel.PointsRequired, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </Border>
                        </StackPanel>

                        <!-- Field 6: กล่องวันที่ (วันที่เริ่มต้น vs วันที่สิ้นสุด) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Start Date -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="วันที่เริ่มต้น" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding EditStartDate, Mode=TwoWay}"
                                            Style="{StaticResource LightDatePickerStyle}"/>
                            </StackPanel>

                            <!-- End Date -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="วันที่สิ้นสุด" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding EditEndDate, Mode=TwoWay}"
                                            Style="{StaticResource LightDatePickerStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- แถบสรุปการใช้งานของการ์ดที่เลือก -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="สถิติการใช้งานโปรโมชั่นนี้" FontSize="13" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Usage Count -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="ใช้สิทธิ์ไปแล้ว" FontSize="12" Foreground="#64748B"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding EditModel.UsageCount, StringFormat='{}{0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text=" ครั้ง" FontSize="12" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Rectangle Grid.Column="1" Fill="#E2E8F0"/>

                                    <!-- Right: Total Discount Given (ห้ามใช้สัญลักษณ์ ฿ เด็ดขาด) -->
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="ส่วนลดที่ให้ไปทั้งสิ้น" FontSize="12" Foreground="#64748B"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding EditModel.TotalDiscountGivenFormatted}" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                                            <TextBlock Text=" บาท" FontSize="12" Foreground="#0284C7" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ชุดปุ่มบันทึกด้านล่าง: [ ยกเลิก ] คู่กับ [ บันทึกการแก้ไข ] -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource SecondaryBtnStyle}" Content="ยกเลิก"
                                    Command="{Binding CancelEditCommand}"/>

                            <Button Grid.Column="2" Style="{StaticResource PrimaryActionBtnStyle}" Height="44"
                                    Command="{Binding SavePromotionCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="บันทึกข้อมูล" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- ปุ่มล่างสุด: [ 🗑️ เก็บถาวร/ลบโปรโมชั่นนี้ ] -->
                        <Button Style="{StaticResource DangerBtnStyle}"
                                Command="{Binding DeletePromotionCommand}"
                                Visibility="{Binding IsCreatingNew, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="เก็บถาวร / ลบโปรโมชั่นนี้" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
