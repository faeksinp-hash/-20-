<Window x:Class="Porjai20.Views.PointRedeemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Porjai20.ViewModels"
        mc:Ignorable="d"
        Title="แลกแต้มสะสม"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Noto Sans Thai, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Outer Container with Shadow Padding -->
    <Grid Margin="20" ClipToBounds="False">
        <Border Width="540" Background="#FFFFFF" CornerRadius="16" BorderBrush="#BAE6FD" BorderThickness="1.5"
                Padding="24" ClipToBounds="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#0B2545" Opacity="0.22"/>
            </Border.Effect>

            <StackPanel>
                <!-- 1. Header: Title -->
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="แลกแต้มสะสม" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </Grid>

                <!-- 2. Customer Points Banner (Amber Card) -->
                <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="★ " FontSize="18" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="แต้มคงเหลือของ คุณ "/><Run Text="{Binding CustomerName, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding CurrentPoints, Mode=OneWay, StringFormat='{}{0:N0}'}"/><Run Text=" แต้ม"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 3. Redeem Promotions List Section -->
                <TextBlock Text="เลือกโปรโมชั่นแลกแต้มที่ต้องการใช้:" FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,8"/>

                <!-- Cards Scroll Viewer -->
                <ScrollViewer MaxHeight="300"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              Margin="0,0,0,14">
                    <ItemsControl ItemsSource="{Binding PromoCards}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,0,8" Cursor="{Binding IsEligible, Converter={x:Null}}"
                                        IsEnabled="{Binding IsEligible}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Padding="12" Margin="0,2"
                                                    Background="{Binding CardBackground}"
                                                    BorderBrush="{Binding CardBorderBrush}"
                                                    BorderThickness="{Binding CardBorderThickness}"
                                                    Opacity="{Binding IsEligible, Converter={x:Null}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEligible}" Value="False">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Main Card Content: Left Info + Right Badge & Radio -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left Icon -->
                                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="🎁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Middle Text Details -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PromoName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                            
                                                            <!-- Condition: Min Spend -->
                                                            <TextBlock Text="{Binding DisplayMinSpend}" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>

                                                            <!-- Target Products (if specific) -->
                                                            <TextBlock Text="{Binding TargetProductNames}" FontSize="12.5" Foreground="#0284C7" FontWeight="SemiBold"
                                                                       Margin="0,2,0,0" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- Right Side: Red Discount & Radio Indicator -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding DisplayDiscount}" FontSize="16" FontWeight="Bold" Foreground="#E11D48" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                            <!-- Radio / Selection Indicator -->
                                                            <Border Width="22" Height="22" CornerRadius="11" BorderThickness="2" VerticalAlignment="Center"
                                                                    BorderBrush="{Binding IsSelected, Converter={x:Null}}"
                                                                    Background="{Binding IsSelected, Converter={x:Null}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                                        <Setter Property="Background" Value="White"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="#0284C7"/>
                                                                                <Setter Property="Background" Value="#0284C7"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="✓" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Ineligible Warning Badge -->
                                                    <Border Grid.Row="1" Margin="46,6,0,0" Padding="8,4" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEligible}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding IneligibleReason}" FontSize="12" FontWeight="SemiBold" Foreground="#DC2626"/>
                                                    </Border>

                                                    <!-- Inline Input for Standard 1:1 Redemption when Selected -->
                                                    <Border Grid.Row="1" Margin="46,8,0,0" Padding="10,8" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsStandardRedeem}" Value="True"/>
                                                                            <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="ระบุแต้มที่ต้องการใช้:" FontSize="13.5" FontWeight="SemiBold" Foreground="#0369A1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBox Grid.Column="1" Text="{Binding CustomPointsText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                     FontSize="15" FontWeight="Bold" Foreground="#0B2545" TextAlignment="Center" VerticalContentAlignment="Center"
                                                                     Height="32" Background="White" BorderBrush="#38BDF8" BorderThickness="1.5"/>
                                                            <TextBlock Grid.Column="2" Text=" แต้ม" FontSize="13.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding MaxCustomPoints, StringFormat='(สูงสุด {0} แต้ม)'}" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 4. Footer: Summary Box (Visible when a card is selected) -->
                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="ใช้แต้ม: " FontSize="15" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedPointsToUse}" FontSize="16" FontWeight="ExtraBold" Foreground="#0369A1" VerticalAlignment="Center"/>
                        <TextBlock Text=" แต้ม ➔ ได้รับส่วนลด: " FontSize="15" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedDiscount, StringFormat={}{0:N2}}" FontSize="17" FontWeight="ExtraBold" Foreground="#E11D48" VerticalAlignment="Center"/>
                        <TextBlock Text=" บาท" FontSize="15" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Validation message if any -->
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#EF4444" FontSize="13.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,-8,0,12"
                           Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}"/>

                <!-- 5. Action Buttons -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cancel Button -->
                    <Button Grid.Column="0" Command="{Binding CancelCommand}" Click="BtnCancel_Click"
                            IsCancel="True"
                            Height="44" MinWidth="110" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnCancel" Background="#F1F5F9" CornerRadius="8">
                                    <TextBlock Text="ยกเลิก" Foreground="#475569" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnCancel" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Confirm Button -->
                    <Button Grid.Column="2" Command="{Binding ConfirmCommand}" Click="BtnConfirm_Click"
                            IsEnabled="{Binding CanConfirmRedeem}"
                            Height="44" MinWidth="160" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnConfirm" Background="#0284C7" CornerRadius="8">
                                    <TextBlock Text="ยืนยันการแลกแต้ม" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnConfirm" Property="Background" Value="#38BDF8"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="btnConfirm" Property="Background" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
