<Window x:Class="Porjai20.Views.PointRedeemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="แลกแต้มสะสม"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Noto Sans Thai, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Outer Container with Shadow Padding -->
    <Grid Margin="20" ClipToBounds="False">
        <Border Width="520" Background="#FFFFFF" CornerRadius="16" BorderBrush="#BAE6FD" BorderThickness="1.5"
                Padding="28,24" ClipToBounds="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#0B2545" Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header: Title and Close (x) button -->
                <Grid Margin="0,0,0,18">
                    <TextBlock Text="แลกแต้มสะสม" FontSize="22" FontWeight="Bold" Foreground="#0B2545" VerticalAlignment="Center"/>
                    
                    <Button Click="BtnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Width="36" Height="36">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="xBorder" Background="{TemplateBinding Background}" CornerRadius="18">
                                    <TextBlock Text="✕" Foreground="#64748B" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="xBorder" Property="Background" Value="#FEE2E2"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Points Info Box -->
                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets, Segoe UI Emoji" FontSize="20" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtPointsInfo" FontSize="16" FontWeight="SemiBold" Foreground="#0369A1" VerticalAlignment="Center">
                                <Run Text="แต้มคงเหลือของ คุณ "/><Run x:Name="runCustomerName" Text="ลูกค้า"/><Run Text=" : "/><Run x:Name="runCurrentPoints" Text="0" FontWeight="Bold"/><Run Text=" แต้ม"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="อัตราแลกเปลี่ยน: 1 แต้ม = 1 บาท" Foreground="#64748B" FontSize="14" Margin="28,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Input Box for Points -->
                <TextBlock Text="ระบุจำนวนแต้มที่ต้องการใช้:" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,2"/>
                <Border CornerRadius="8" BorderBrush="#38BDF8" BorderThickness="1.5" Background="#FFFFFF" Height="50" Margin="0,6,0,16">
                    <Grid>
                        <TextBox x:Name="txtInputPoints"
                                 TextChanged="TxtInputPoints_TextChanged"
                                 FontSize="22" FontWeight="Bold" Foreground="#0B2545"
                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="30,0,60,0"/>
                        <TextBlock Text="แต้ม" FontSize="16" FontWeight="SemiBold" Foreground="#64748B"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Realtime Calculation Note -->
                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="มูลค่าส่วนลดที่จะได้รับ: " FontSize="18" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE945; " FontFamily="Segoe MDL2 Assets, Segoe UI Emoji" FontSize="18" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBlock x:Name="txtCalculatedDiscount" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                        <TextBlock Text=" บาท" FontSize="18" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Validation Message -->
                <TextBlock x:Name="txtValidationMessage" Text="" Foreground="#EF4444" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,-8,0,14" Visibility="Collapsed"/>

                <!-- Action Buttons -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cancel Button -->
                    <Button Grid.Column="0" Click="BtnCancel_Click"
                            Height="46" MinWidth="110" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnCancel" Background="#F1F5F9" CornerRadius="8">
                                    <TextBlock Text="ยกเลิก" Foreground="#475569" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnCancel" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Confirm Button -->
                    <Button Grid.Column="2" Click="BtnConfirm_Click"
                            Height="46" MinWidth="160" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnConfirm" Background="#0284C7" CornerRadius="8">
                                    <TextBlock Text="ยืนยันการแลกแต้ม" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnConfirm" Property="Background" Value="#38BDF8"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="btnConfirm" Property="Background" Value="#94A3B8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
