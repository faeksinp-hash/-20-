<Window x:Class="Porjai20.Views.ReceiptDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="รายละเอียดใบเสร็จ"
        Height="680" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Noto Sans Thai, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="#FFFFFF"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#BAE6FD">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Scrollable Receipt Content -->
                <RowDefinition Height="Auto"/> <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- Dialog Top Header -->
            <Border Grid.Row="0"
                    Background="#00A3E0"
                    CornerRadius="15,15,0,0"
                    Padding="18,14">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Click="CloseBtn_Click"
                            Width="32" Height="32"
                            Background="#E0F2FE"
                            Foreground="#0B2545"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="Bold"
                            FontSize="15">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="16"/>
                            </Style>
                        </Button.Resources>
                        ✕
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧾" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="รายละเอียดใบเสร็จ" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Receipt Content (Scrollable & Printable) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel x:Name="ReceiptArea" Background="White">
                    <!-- Shop Header -->
                    <TextBlock Text="ร้านพอใจ ทุกอย่าง 20 บาท"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="ใบเสร็จรับเงิน / รายการขาย"
                               FontSize="14" Foreground="#64748B"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- Bill Metadata Box -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="เลขที่บิล:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RefNo}" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right" Margin="0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="วันที่-เวลา:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormattedDate}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ลูกค้า:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CustomerName}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,2"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="สถานะบิล:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2"/>
                            <Border Grid.Row="3" Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    CornerRadius="8" Padding="8,2" Margin="0,2"
                                    Background="{Binding StatusBg}">
                                <TextBlock Text="{Binding Sales_Status}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{Binding StatusFg}"/>
                            </Border>

                            <!-- โปรโมชั่นที่ใช้ -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="โปรโมชั่น:" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2"
                                       Visibility="{Binding HasPromotion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Border Grid.Row="4" Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    CornerRadius="6" Padding="10,3" Margin="0,2"
                                    Background="#E0F2FE"
                                    Visibility="{Binding HasPromotion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding PromoDescription}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="#0284C7"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Items Header -->
                    <Border Background="#E0F2FE" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="รายการสินค้า" FontWeight="Bold" Foreground="#0B2545" FontSize="13.5"/>
                            <TextBlock Grid.Column="1" Text="ราคา" FontWeight="Bold" Foreground="#0B2545" FontSize="13.5" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="จำนวน" FontWeight="Bold" Foreground="#0B2545" FontSize="13.5" TextAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="รวม" FontWeight="Bold" Foreground="#0B2545" FontSize="13.5" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Items List -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="6,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="60"/>
                                             <ColumnDefinition Width="50"/>
                                             <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}" Foreground="#0F172A" FontSize="13.5" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat={}{0:N2}}" Foreground="#475569" FontSize="13.5" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Quantity}" Foreground="#475569" FontSize="13.5" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Total, StringFormat={}{0:N2}}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13.5" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Summary Section -->
                    <Border Margin="0,14,0,0" Padding="14,12" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <!-- 1. ยอดรวมสินค้าก่อนลด -->
                            <DockPanel LastChildFill="False" Margin="0,4,0,2">
                                <TextBlock DockPanel.Dock="Left" FontSize="15" Foreground="#64748B" Text="ยอดรวมสินค้า"/>
                                <TextBlock DockPanel.Dock="Right" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding SubtotalAmount, StringFormat='{}{0:N2}'}"/>
                            </DockPanel>

                            <!-- 2. ส่วนลดโปรโมชั่น (แสดงเฉพาะเมื่อ HasDiscount == true) -->
                            <DockPanel LastChildFill="False" Margin="0,2,0,4" Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock DockPanel.Dock="Left" FontSize="15" Foreground="#E11D48" Text="{Binding PromoDescription, TargetNullValue='ส่วนลดโปรโมชั่น'}"/>
                                <TextBlock DockPanel.Dock="Right" FontSize="15" FontWeight="Bold" Foreground="#E11D48" Text="{Binding DiscountAmount, StringFormat='-{0:N2}'}"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,2,0,4" Visibility="{Binding HasPointsUsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock DockPanel.Dock="Left" FontSize="14" Foreground="#DC2626" Text="แต้มที่ใช้แลก"/>
                                <TextBlock DockPanel.Dock="Right" FontSize="14" FontWeight="SemiBold" Foreground="#DC2626" Text="{Binding PointsUsed, StringFormat='-{0} แต้ม'}"/>
                            </DockPanel>

                            <!-- 3. รับเงินสด / เงินทอน -->
                            <DockPanel LastChildFill="False" Margin="0,2,0,2">
                                <TextBlock DockPanel.Dock="Left" FontSize="14" Foreground="#64748B" Text="รับเงินสด"/>
                                <TextBlock DockPanel.Dock="Right" FontSize="14" Foreground="#0F172A" Text="{Binding ReceivedAmount, StringFormat='{}{0:N2}'}"/>
                            </DockPanel>
                            <DockPanel LastChildFill="False" Margin="0,2,0,6">
                                <TextBlock DockPanel.Dock="Left" FontSize="14" Foreground="#64748B" Text="เงินทอน"/>
                                <TextBlock DockPanel.Dock="Right" FontSize="14" Foreground="#0F172A" Text="{Binding ChangeAmount, StringFormat='{}{0:N2}'}"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,2,0,4">
                                <TextBlock DockPanel.Dock="Left" FontSize="13.5" Foreground="#64748B" Text="วิธีชำระเงิน"/>
                                <TextBlock DockPanel.Dock="Right" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" Text="{Binding Sales_PaymentType}"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,2,0,4" Visibility="{Binding HasPointsEarned, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock DockPanel.Dock="Left" FontSize="13.5" Foreground="#16A34A" Text="★ แต้มที่ได้รับจากบิลนี้"/>
                                <TextBlock DockPanel.Dock="Right" FontSize="14" FontWeight="Bold" Foreground="#16A34A" Text="{Binding PointsEarned, StringFormat='+{}{0} แต้ม'}"/>
                            </DockPanel>

                            <!-- 4. เส้นคั่นและยอดรวมสุทธิทั้งสิ้น -->
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,6,0,8"/>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Text="ยอดรวมสุทธิทั้งสิ้น" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" FontSize="22" FontWeight="Bold" Foreground="#0284C7" Text="{Binding NetAmount, StringFormat='{}{0:N2}'}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Footer -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,15,15"
                    Padding="16">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Click="PrintBtn_Click"
                            Background="#00A3E0"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            Padding="20,0"
                            Height="40"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        🖨 พิมพ์ใบเสร็จ
                    </Button>

                    <Button DockPanel.Dock="Right"
                            Click="CloseBtn_Click"
                            Background="#E2E8F0"
                            Foreground="#334155"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Padding="22,0"
                            Height="40"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        ปิด
                    </Button>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
