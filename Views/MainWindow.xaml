                                                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                               ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                            <views:SalesHistoryView.DataContext>
                                                <vm:SalesHistoryViewModel/>
                                            </views:SalesHistoryView.DataContext>
                                        </views:SalesHistoryView>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY 1: ADD/EDIT CUSTOMER -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsCustomerModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="620"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Bar with Title -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding CustomerModalTitle, FallbackValue='⚙️ จัดการข้อมูลลูกค้า'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#0B2545"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Form Fields Wrapper Card -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#38BDF8"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="18"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Customer Code -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="รหัสลูกค้า *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CustomerCode, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Foreground="#0284C7"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Customer Name -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="ชื่อ-นามสกุล *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditCustomer}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Full Width: Phone Number -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                                <TextBlock Text="เบอร์โทรศัพท์ *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditCustomer}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Full Width: Address -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                                <TextBlock Text="ที่อยู่ / รายละเอียดที่ตั้ง" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CustomerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditCustomer}"
                                             Style="{StaticResource MultiLineTextBoxStyle}"
                                             Height="76" Padding="12,8" FontSize="15" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding CustomerValidationMessage}"
                               Visibility="{Binding HasCustomerValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Action Buttons Bar -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Save Button -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveCustomerCommand}"
                                IsEnabled="{Binding CanEditCustomer}"
                                Content="💾 บันทึกข้อมูล"
                                Style="{StaticResource PrimaryBtnStyle}"
                                BorderBrush="#0284C7" BorderThickness="1.5"
                                Height="46" FontSize="16" FontWeight="Bold"/>

                        <!-- Clear Button -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearCustomerCommand}"
                                IsEnabled="{Binding CanEditCustomer}"
                                Content="🧹 ล้างข้อมูล"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#38BDF8" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Delete Button -->
                        <Button Grid.Column="4"
                                Command="{Binding DeleteCustomerCommand}"
                                IsEnabled="{Binding CanEditCustomer}"
                                Content="🗑️ ลบ"
                                Style="{StaticResource DangerBtnStyle}"
                                BorderBrush="#FCA5A5" BorderThickness="1.5"
                                Height="46" Padding="16,0" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="6"
                                Command="{Binding CloseCustomerModalCommand}"
                                Content="❌ ยกเลิก"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#38BDF8" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY 2: CUSTOMER HISTORY  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsCustomerHistoryModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="998">
            <Border Width="720"
                    MaxHeight="680"
                    Background="#E0F2FE"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Header -->
                        <RowDefinition Height="Auto"/>   <!-- Selected Customer Summary Inset Card -->
                        <RowDefinition Height="*"/>      <!-- History DataGrid Table -->
                        <RowDefinition Height="Auto"/>   <!-- Divider Line -->
                        <RowDefinition Height="Auto"/>   <!-- Footer Summary & Actions -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Title and Prominent Circular Close Button -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 " FontSize="20"/>
                            <StackPanel>
                                <TextBlock Text="ประวัติการสั่งซื้อลูกค้า"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#2D3748"
                                           Margin="0"/>
                                <TextBlock Text="รายการประวัติการสั่งซื้อและยอดชำระสะสมของลูกค้า"
                                           FontSize="12.5"
                                           Foreground="#718096"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Circular Close Button -->
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseCustomerHistoryModalCommand}"
                                Style="{StaticResource ModalCloseButtonStyle}"/>
                    </DockPanel>

                    <!-- Row 1: Customer Summary Inset Box -->
                    <Border Grid.Row="1"
                            Background="#E0F2FE"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="👤 ชื่อลูกค้า:" FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CustomerHistoryName}"
                                       FontSize="14" FontWeight="Bold" Foreground="#2D3748"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0">
                                <TextBlock Text="📞 เบอร์โทรศัพท์:" FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding CustomerHistoryPhone}"
                                       FontSize="14" FontWeight="Bold" Foreground="#2D3748"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: History DataGrid Table -->
                    <Border Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            MaxHeight="360"
                            Effect="{StaticResource SoftShadow}">

                        <DataGrid ItemsSource="{Binding CustomerHistoryOrders}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True" 
                                  HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  RowHeight="44"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  CanUserSortColumns="True"
                                  ColumnHeaderStyle="{StaticResource POColumnHeaderStyle}"
                                  RowStyle="{StaticResource PORowStyle}"
                                  CellStyle="{StaticResource POCellStyle}"
                                  SelectionMode="Single">
                            <DataGrid.Columns>

                                <!-- #1: Timestamp -->
                                <DataGridTextColumn Header="วันที่/เวลา"
                                                    Binding="{Binding Timestamp, StringFormat=dd/MM/yyyy HH:mm}"
                                                    Width="1.4*"
                                                    ElementStyle="{StaticResource ColCenter}"/>

                                <!-- #2: RefNo -->
                                <DataGridTextColumn Header="เลขที่บิล"
                                                    Binding="{Binding RefNo}"
                                                    Width="1.8*"
                                                    ElementStyle="{StaticResource ColCenterBold}"/>

                                <!-- #3: Total Amount -->
                                <DataGridTextColumn Header="ยอดสุทธิ"
                                                    Binding="{Binding TotalAmount, StringFormat={}{0:N2}}"
                                                    Width="1.4*"
                                                    ElementStyle="{StaticResource ColAmountStyle}"/>

                                <!-- #4: Payment Method -->
                                <DataGridTextColumn Header="วิธีการชำระ"
                                                    Binding="{Binding PaymentMethod}"
                                                    Width="1.2*"
                                                    ElementStyle="{StaticResource ColCenter}"/>

                                <!-- #5: Delivery Status -->
                                <DataGridTextColumn Header="สถานะจัดส่ง"
                                                    Binding="{Binding DeliveryStatus}"
                                                    Width="1.2*"
                                                    ElementStyle="{StaticResource ColCenter}"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Row 3: Horizontal Separator Line -->
                    <Border Grid.Row="3" Height="1" Background="#BAE6FD" Margin="0,16"/>

                    <!-- Row 4: Footer Summary Bar & Actions -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="จำนวนรายการรวม: " FontSize="15" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBlock Text="{Binding CustomerHistoryTotalOrders}"
                                       FontSize="15" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,24,0"/>

                            <TextBlock Text="ยอดรวมทั้งหมด: " FontSize="15" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBlock Text="{Binding CustomerHistoryTotalSpent, StringFormat={}{0:N2}}"
                                       FontSize="18" FontWeight="Bold" Foreground="#0B2545"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="ปิดหน้าต่าง"
                                Command="{Binding CloseCustomerHistoryModalCommand}"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Padding="20,0" Height="42"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT STAFF    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsStaffModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="620"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Bar with Title -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding StaffModalTitle, FallbackValue='⚙️ จัดการข้อมูลพนักงาน'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#0B2545"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card (Light Blue Border Grid Container) -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#7DD3FC"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Username (ชื่อผู้ใช้งาน) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="ชื่อผู้ใช้งาน / Username *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding StaffUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Password (รหัสผ่าน) -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="รหัสผ่าน / Password *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding StaffPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Left: Full Name (ชื่อ-นามสกุล) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="ชื่อ-นามสกุล *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding StaffName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Right: Phone Number (เบอร์โทรศัพท์) -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="เบอร์โทรศัพท์ *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding StaffPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Full Width: Role / Position (สิทธิ์การใช้งาน) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                                <TextBlock Text="สิทธิ์การใช้งาน / ตำแหน่ง *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <ComboBox SelectedValue="{Binding StaffRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Content"
                                              Style="{StaticResource LightComboBoxStyle}"
                                              Height="44" Padding="12,0" Background="Transparent" BorderThickness="0">
                                        <ComboBoxItem Content="ผู้ดูแลระบบ"/>
                                        <ComboBoxItem Content="เจ้าของร้าน"/>
                                        <ComboBoxItem Content="พนักงานทั่วไป"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding StaffValidationMessage}"
                               Visibility="{Binding HasStaffValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Action Buttons Bar -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Save Button -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveStaffCommand}"
                                Content="💾 บันทึกข้อมูล"
                                Style="{StaticResource PrimaryBtnStyle}"
                                BorderBrush="#0284C7" BorderThickness="1.5"
                                Height="46" FontSize="16" FontWeight="Bold"/>

                        <!-- Clear Button (Visible only in Add Mode) -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearStaffCommand}"
                                Content="✏️ ล้างข้อมูล"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Delete Button (Visible in Edit Mode) -->
                        <Button Grid.Column="4"
                                Command="{Binding DeleteStaffCommand}"
                                Content="🗑️ ลบ"
                                Style="{StaticResource DangerBtnStyle}"
                                BorderBrush="#FCA5A5" BorderThickness="1.5"
                                Height="46" Padding="16,0" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="6"
                                Command="{Binding CloseStaffModalCommand}"
                                Content="❌ ยกเลิก"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT PARTNER  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsPartnerModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="620"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Bar with Title -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding PartnerModalTitle, FallbackValue='⚙️ จัดการข้อมูลบริษัทคู่ค้า'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#0B2545"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card (Light Blue Border Grid Container) -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#7DD3FC"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Partner Code (รหัสบริษัทคู่ค้า) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="รหัสบริษัทคู่ค้า *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding PartnerCode, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Foreground="#0284C7"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Partner Name (ชื่อบริษัท / ซัพพลายเออร์) -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="ชื่อบริษัท / ซัพพลายเออร์ *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding PartnerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Left: Contact Person (ชื่อผู้ติดต่อ) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="ชื่อผู้ติดต่อ" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding PartnerContactPerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Right: Phone Number (เบอร์โทรศัพท์) -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="เบอร์โทรศัพท์ *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding PartnerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Full Width: Email (อีเมล) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                                <TextBlock Text="อีเมล (Email)" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding PartnerEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 3 Full Width: Address (ที่อยู่ / รายละเอียดที่ตั้ง) -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                                <TextBlock Text="ที่อยู่ / รายละเอียดที่ตั้ง" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding PartnerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MultiLineTextBoxStyle}"
                                             Height="76" Padding="12,8" FontSize="15" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding PartnerValidationMessage}"
                               Visibility="{Binding HasPartnerValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Action Buttons Bar -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Save Button -->
                        <Button Grid.Column="0"
                                Command="{Binding SavePartnerCommand}"
                                Content="💾 บันทึกข้อมูล"
                                Style="{StaticResource PrimaryBtnStyle}"
                                BorderBrush="#0284C7" BorderThickness="1.5"
                                Height="46" FontSize="16" FontWeight="Bold"/>

                        <!-- Clear Button (Visible only in Add Mode) -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearPartnerCommand}"
                                Content="✏️ ล้างข้อมูล"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Delete Button (Visible in Edit Mode) -->
                        <Button Grid.Column="4"
                                Command="{Binding DeletePartnerCommand}"
                                Content="🗑️ ลบ"
                                Style="{StaticResource DangerBtnStyle}"
                                BorderBrush="#FCA5A5" BorderThickness="1.5"
                                Height="46" Padding="16,0" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="6"
                                Command="{Binding ClosePartnerModalCommand}"
                                Content="❌ ยกเลิก"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT EXPENSE   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsExpenseModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="620"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Bar with Title -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding ExpenseModalTitle, FallbackValue='⚙️ จัดการข้อมูลรายจ่าย'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#0B2545"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card (Light Blue Border Grid Container) -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#7DD3FC"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Expense Category (หมวดหมู่รายจ่าย) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="หมวดหมู่รายจ่าย *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <ComboBox ItemsSource="{Binding ExpenseCategories}"
                                              SelectedItem="{Binding SelectedExpenseCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource LightComboBoxStyle}"
                                              Height="44" Padding="12,0" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Expense Amount (จำนวนเงิน บาท) -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="จำนวนเงิน (บาท) *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding ExpenseAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Full Width: Expense Description (รายละเอียดรายการ) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                                <TextBlock Text="รายละเอียดรายการ *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding ExpenseDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Left: Expense Date (วันที่ทำรายการ) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,0">
                                <TextBlock Text="วันที่ทำรายการ *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <DatePicker SelectedDate="{Binding ExpenseDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Height="44" Padding="6,0" FontSize="15" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Right: Expense Note (หมายเหตุเพิ่มเติม) -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                                <TextBlock Text="หมายเหตุเพิ่มเติม" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding ExpenseNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding ExpenseValidationMessage}"
                               Visibility="{Binding HasExpenseValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Action Buttons Bar -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Save Button -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveExpenseCommand}"
                                Content="💾 บันทึกข้อมูล"
                                Style="{StaticResource PrimaryBtnStyle}"
                                BorderBrush="#0284C7" BorderThickness="1.5"
                                Height="46" FontSize="16" FontWeight="Bold"/>

                        <!-- Clear Button (Visible only in Add Mode) -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearExpenseCommand}"
                                Content="✏️ ล้างข้อมูล"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Delete Button (Visible in Edit Mode) -->
                        <Button Grid.Column="4"
                                Command="{Binding DeleteExpenseCommand}"
                                Content="🗑️ ลบ"
                                Style="{StaticResource DangerBtnStyle}"
                                BorderBrush="#FCA5A5" BorderThickness="1.5"
                                Height="46" Padding="16,0" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="6"
                                Command="{Binding CloseExpenseModalCommand}"
                                Content="❌ ยกเลิก"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT PRODUCT   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsProductFormOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="640"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Bar with Title -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding ProductModalTitle, FallbackValue='⚙️ จัดการข้อมูลสินค้า'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#0B2545"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card (Light Blue Border Grid Container) -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#7DD3FC"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Product Code (รหัสสินค้า - Auto Generated & Read-Only) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="รหัสสินค้า (อัตโนมัติ) *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#F1F5F9" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding ProductCode, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Height="44" Padding="12,0" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Product Name (ชื่อสินค้า) -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="ชื่อสินค้า *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Left: Category (หมวดหมู่สินค้า - Searchable / Selectable Dropdown) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="หมวดหมู่สินค้า *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <ComboBox ItemsSource="{Binding ProductCategories}"
                                              DisplayMemberPath="CategoryName"
                                              SelectedValuePath="CategoryID"
                                              SelectedValue="{Binding CategoryID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedItem="{Binding SelectedProductCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="CategoryName"
                                              IsEnabled="{Binding CanEditStockManage}"
                                              Style="{StaticResource LightComboBoxStyle}"
                                              Height="44" Padding="12,0" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Right: Unit (หน่วยนับ) -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="หน่วยนับ *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Left: Cost Price (ราคาทุน) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="ราคาทุน (บาท)" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CostPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Right: Selling Price (ราคาขาย) -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="ราคาขาย (บาท) *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 3 Left: Stock Qty (จำนวนคงเหลือ) -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="จำนวนคงเหลือ *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding Stock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 3 Right: Reorder Point (จุดสั่งซื้อขั้นต่ำ) -->
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="จุดสั่งซื้อขั้นต่ำ (Reorder Point)" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding ReorderPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 4 Full Width: Product Image Upload Section (อัปโหลดรูปภาพสินค้า) -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                                <TextBlock Text="รูปภาพสินค้า" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Image Preview Box -->
                                        <Border Grid.Column="0" Height="90" Background="#F8FAFC" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                            <Grid>
                                                <!-- Placeholder when no image -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Visibility="{Binding HasImagePath, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="📷" FontSize="28" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                                                    <TextBlock Text="ไม่มีรูปภาพ" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Image Preview -->
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"
                                                       Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Controls & Details -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="อัปโหลดรูปภาพสินค้า (.png, .jpg, .webp)" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,8"/>
                                            
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Select / Upload Image Button -->
                                                <Button Command="{Binding BrowseImageCommand}"
                                                        IsEnabled="{Binding CanEditStockManage}"
                                                        Content="🖼️ เลือกรูปภาพ"
                                                        Style="{StaticResource SecondaryBtnStyle}"
                                                        Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                                        Height="36" Padding="14,0" FontSize="13" FontWeight="Bold" Margin="0,0,8,0"/>

                                                <!-- Remove Image Button -->
                                                <Button Command="{Binding RemoveImageCommand}"
                                                        IsEnabled="{Binding CanEditStockManage}"
                                                        Content="🗑️ ลบรูปภาพ"
                                                        Style="{StaticResource DangerBtnStyle}"
                                                        BorderBrush="#FCA5A5" BorderThickness="1.5"
                                                        Height="36" Padding="12,0" FontSize="13" FontWeight="Bold"
                                                        Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <!-- File Path / Status Text -->
                                            <TextBlock Text="{Binding ImagePath}"
                                                       FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                                       Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Error Message -->
                    <TextBlock Text="{Binding ProductValidationMessage}"
                               Visibility="{Binding HasProductValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Action Buttons Bar -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Save Button -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveProductFormCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Content="💾 บันทึกข้อมูลสินค้า"
                                Style="{StaticResource PrimaryBtnStyle}"
                                BorderBrush="#0284C7" BorderThickness="1.5"
                                Height="46" FontSize="16" FontWeight="Bold"/>

                        <!-- Clear Button (Visible only in Add Mode) -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearFormCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Content="✏️ ล้างข้อมูล"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Delete Button (Visible in Edit Mode) -->
                        <Button Grid.Column="4"
                                Command="{Binding StockDeleteProductCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Content="🗑️ ลบ"
                                Style="{StaticResource DangerBtnStyle}"
                                BorderBrush="#FCA5A5" BorderThickness="1.5"
                                Height="46" Padding="16,0" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="6"
                                Command="{Binding CloseStockManageModalCommand}"
                                Content="❌ ยกเลิก"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT CATEGORY   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsCategoryModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="560"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Bar with Title -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding CategoryModalTitle, FallbackValue='⚙️ จัดการประเภทสินค้า'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#0B2545"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card (Light Blue Border Grid Container) -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#7DD3FC"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Category Code (รหัสหมวดหมู่ - Auto Generated & Read-Only) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="รหัสหมวดหมู่ (อัตโนมัติ) *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#F1F5F9" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CategoryCode, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Height="44" Padding="12,0" FontSize="16" FontWeight="SemiBold" Foreground="#0284C7"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Category Name (ชื่อประเภทสินค้า) -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="ชื่อประเภทสินค้า *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Full Width: Description (รายละเอียดหมวดหมู่) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                                <TextBlock Text="รายละเอียดหมวดหมู่" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CategoryDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource MultiLineTextBoxStyle}"
                                             Height="76" Padding="12,8" FontSize="15" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding CategoryValidationMessage}"
                               Visibility="{Binding HasCategoryValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Action Buttons Bar -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Save Button -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveCategoryCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Content="💾 บันทึกข้อมูล"
                                Style="{StaticResource PrimaryBtnStyle}"
                                BorderBrush="#0284C7" BorderThickness="1.5"
                                Height="46" FontSize="16" FontWeight="Bold"/>

                        <!-- Clear Button (Visible only in Add Mode) -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearCategoryCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Content="✏️ ล้างข้อมูล"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsCategoryEditMode, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Delete Button (Visible in Edit Mode) -->
                        <Button Grid.Column="4"
                                Command="{Binding DeleteCategoryCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Content="🗑️ ลบ"
                                Style="{StaticResource DangerBtnStyle}"
                                BorderBrush="#FCA5A5" BorderThickness="1.5"
                                Height="46" Padding="16,0" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsCategoryEditMode, Converter={StaticResource BoolToVis}}"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="6"
                                Command="{Binding CloseCategoryModalCommand}"
                                Content="❌ ยกเลิก"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  UNIVERSAL TOP-LEVEL IN-PAGE CONFIRMATION MODAL OVERLAY     -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#A0000000"
              Visibility="{Binding IsMainConfirmOpen, Converter={StaticResource BoolToVis}}"
              Grid.ColumnSpan="99" Grid.RowSpan="99"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Panel.ZIndex="10000">
            <Border Width="440"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icon Avatar Badge -->
                    <Border Width="60" Height="60" CornerRadius="30" Background="#FEF2F2" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="⚠️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="{Binding MainConfirmTitle, FallbackValue='ยืนยันการทำรายการ'}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#0B2545"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Message -->
                    <TextBlock Text="{Binding MainConfirmMessage}"
                               FontSize="15"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Action Buttons Bar: Confirm & Cancel -->
                    <Grid Width="340">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Confirm Button -->
                        <Button Grid.Column="0"
                                Content="✅ ยืนยัน"
                                Command="{Binding ConfirmMainActionCommand}"
                                Style="{StaticResource DangerBtnStyle}"
                                Height="42"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="2"
                                Content="❌ ยกเลิก"
                                Command="{Binding CancelMainActionCommand}"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Height="42"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  UNIVERSAL TOP-LEVEL IN-PAGE ALERT MODAL OVERLAY           -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#A0111827"
              Visibility="{Binding IsMainAlertOpen, Converter={StaticResource BoolToVis}}"
              Grid.ColumnSpan="99" Grid.RowSpan="99"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Panel.ZIndex="10001">
            <Border Width="420"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icon Avatar Badge -->
                    <Border Width="60" Height="60" CornerRadius="30" Background="#E0F2FE" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="{Binding MainAlertIcon, FallbackValue='⚠️'}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="{Binding MainAlertTitle, FallbackValue='แจ้งเตือนระบบ'}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#0B2545"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Message -->
                    <TextBlock Text="{Binding MainAlertMessage}"
                               FontSize="15"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Close/OK Button -->
                    <Button Content="ตกลง"
                            Command="{Binding CloseMainAlertCommand}"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Height="42"
                            Width="140"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
</Grid>
</Window>
