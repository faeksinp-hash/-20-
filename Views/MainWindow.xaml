                                    <Setter.Value>
                                        <views:PurchaseOrderView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="expense">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <views:ExpenseView />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="promotion">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <views:PromotionView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                            <views:PromotionView.DataContext>
                                                <vm:PromotionViewModel/>
                                            </views:PromotionView.DataContext>
                                        </views:PromotionView>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="sales_history">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <views:SalesHistoryView HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                               ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                            <views:SalesHistoryView.DataContext>
                                                <vm:SalesHistoryViewModel/>
                                            </views:SalesHistoryView.DataContext>
                                        </views:SalesHistoryView>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY 1: ADD/EDIT CUSTOMER -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsCustomerModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="720"
                    MinWidth="700"
                    MaxWidth="740"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="32,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <Border.Resources>
                    <!-- สถานะกล่องข้อความ: โหมดดูข้อมูลขอบ #E2E8F0 พื้นหลัง #F8FAFC, โหมดแก้ไขขอบ #38BDF8 พื้นหลัง #FFFFFF -->
                    <Style x:Key="CustomerFieldBorderStyle" TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- SingleLine style for customer input fields: font 17, transparent background, borderless, height 50, padding 14,0 -->
                    <Style x:Key="CustomerSingleLineTextBoxStyle" TargetType="TextBox">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="CaretBrush" Value="#0F172A"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <!-- MultiLine style for address field: transparent to inherit CustomerFieldBorderStyle background and border -->
                    <Style x:Key="CustomerMultiLineTextBoxStyle" TargetType="TextBox">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="CaretBrush" Value="#0F172A"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  BorderThickness="0" IsTabStop="False"
                                                  VerticalAlignment="Top"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มสีฟ้า (แก้ไขข้อมูล / บันทึกข้อมูล): ปกติ #0284C7, Hover #38BDF8, Pressed #0369A1, สูง 48, MinWidth 130, Font 17 Bold -->
                    <Style x:Key="CustomerBlueBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#0284C7"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="48"/>
                        <Setter Property="MinWidth" Value="130"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มลบ (สีแดง): ปกติ #EF4444, Hover #F87171, Pressed #DC2626, สูง 48, MinWidth 130, Font 17 Bold -->
                    <Style x:Key="CustomerDeleteBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#EF4444"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="48"/>
                        <Setter Property="MinWidth" Value="130"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F87171"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มปิด / ยกเลิก (สีเทาอ่อน): ปกติ #F1F5F9, ขอบ #CBD5E1, Hover #E2E8F0, ตัวหนังสือ #475569 Bold, สูง 48, MinWidth 130, Font 17 Bold -->
                    <Style x:Key="CustomerNeutralBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="17"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="48"/>
                        <Setter Property="MinWidth" Value="130"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <StackPanel>
                    <!-- 1. Header Bar with Title (FontSize="24", FontWeight="Bold", Foreground="#0F172A", Margin="0,0,0,20") -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,20">
                        <TextBlock Text="{Binding CustomerModalTitle, FallbackValue='ข้อมูลลูกค้า'}"
                                   FontSize="24" FontWeight="Bold" Foreground="#0F172A"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Form Fields Wrapper Card -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="20,18"
                            Margin="0,0,0,20">
                        <Grid>
                            <!-- 2. ปรับสัดส่วนคอลัมน์: Column 0 (รหัสลูกค้า) Width="220", Column 1 (ชื่อ-นามสกุล) Width="*" -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Customer Code (ReadOnly เสมอ เพื่อป้องกันการเปลี่ยน Primary Key) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                                <TextBlock Text="รหัสลูกค้า" FontSize="17" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="8">
                                    <TextBox Text="{Binding CustomerCode, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Foreground="#0284C7"
                                             FontWeight="SemiBold"
                                             Style="{StaticResource CustomerSingleLineTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Customer Name (สัญลักษณ์ดอกจันแสดงเฉพาะโหมดแก้ไข) -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="ชื่อ-นามสกุล" FontSize="17" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="17" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CustomerFieldBorderStyle}">
                                    <TextBox Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             IsEnabled="{Binding CanEditCustomer}"
                                             Style="{StaticResource CustomerSingleLineTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Full Width: Phone Number (สัญลักษณ์ดอกจันแสดงเฉพาะโหมดแก้ไข) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="เบอร์โทรศัพท์" FontSize="17" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="17" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CustomerFieldBorderStyle}">
                                    <TextBox Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             IsEnabled="{Binding CanEditCustomer}"
                                             Style="{StaticResource CustomerSingleLineTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Full Width: Address (สไตล์กล่องข้อความเหมือนช่องอื่น พร้อมรองรับหลายบรรทัด) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <TextBlock Text="ที่อยู่ / รายละเอียดที่ตั้ง" FontSize="17" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource CustomerFieldBorderStyle}">
                                    <TextBox Text="{Binding CustomerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             IsEnabled="{Binding CanEditCustomer}"
                                             Style="{StaticResource CustomerMultiLineTextBoxStyle}"
                                             MinHeight="95" Height="100"
                                             TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding CustomerValidationMessage}"
                               Visibility="{Binding HasCustomerValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Action Buttons Bar -->
                    <!-- 1) ชุดปุ่มโหมดดูข้อมูล (IsEditMode == false): แสดง 3 ปุ่ม [แก้ไขข้อมูล, ลบ, ปิด] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1.1) ปุ่ม "แก้ไขข้อมูล" (สีฟ้า Background="#0284C7", Hover="#38BDF8", ไอคอน ✏️ เว้น Margin="0,0,8,0") -->
                        <Button Grid.Column="0"
                                Command="{Binding EnterCustomerEditModeCommand}"
                                IsEnabled="{Binding CanEditCustomer}"
                                Style="{StaticResource CustomerBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="แก้ไขข้อมูล" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.2) ปุ่ม "ลบ" (สีแดง Background="#EF4444", Hover="#F87171", ไอคอน 🗑️ เว้น Margin="0,0,8,0") -->
                        <Button Grid.Column="2"
                                Command="{Binding DeleteCustomerCommand}"
                                IsEnabled="{Binding CanEditCustomer}"
                                Style="{StaticResource CustomerDeleteBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="ลบ" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.3) ปุ่ม "ปิด" (สีเทาอ่อน Background="#F1F5F9", Hover="#E2E8F0", Foreground="#475569") -->
                        <Button Grid.Column="4"
                                Command="{Binding CloseCustomerModalCommand}"
                                Style="{StaticResource CustomerNeutralBtnStyle}">
                            <TextBlock Text="ปิด" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- 2) ชุดปุ่มโหมดแก้ไข (IsEditMode == true): แสดง 2 ปุ่ม [บันทึกข้อมูล, ยกเลิก] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 2.1) ปุ่ม "บันทึกข้อมูล" (สีฟ้า Background="#0284C7", Hover="#38BDF8", ไอคอน 💾 เว้น Margin="0,0,8,0") -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveCustomerCommand}"
                                IsEnabled="{Binding CanEditCustomer}"
                                Style="{StaticResource CustomerBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💾" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="บันทึกข้อมูล" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2.2) ปุ่ม "ยกเลิก" (สีเทาอ่อน Background="#F1F5F9", Hover="#E2E8F0", Foreground="#475569") -->
                        <Button Grid.Column="2"
                                Command="{Binding CancelCustomerEditCommand}"
                                Style="{StaticResource CustomerNeutralBtnStyle}">
                            <TextBlock Text="ยกเลิก" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY 2: CUSTOMER HISTORY  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsCustomerHistoryModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="998">
            <Border Width="720"
                    MaxHeight="680"
                    Background="#E0F2FE"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Header -->
                        <RowDefinition Height="Auto"/>   <!-- Selected Customer Summary Inset Card -->
                        <RowDefinition Height="*"/>      <!-- History DataGrid Table -->
                        <RowDefinition Height="Auto"/>   <!-- Divider Line -->
                        <RowDefinition Height="Auto"/>   <!-- Footer Summary & Actions -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Title and Prominent Circular Close Button -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 " FontSize="20"/>
                            <StackPanel>
                                <TextBlock Text="ประวัติการสั่งซื้อลูกค้า"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#2D3748"
                                           Margin="0"/>
                                <TextBlock Text="รายการประวัติการสั่งซื้อและยอดชำระสะสมของลูกค้า"
                                           FontSize="12.5"
                                           Foreground="#718096"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Circular Close Button -->
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseCustomerHistoryModalCommand}"
                                Style="{StaticResource ModalCloseButtonStyle}"/>
                    </DockPanel>

                    <!-- Row 1: Customer Summary Inset Box -->
                    <Border Grid.Row="1"
                            Background="#E0F2FE"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="👤 ชื่อลูกค้า:" FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CustomerHistoryName}"
                                       FontSize="14" FontWeight="Bold" Foreground="#2D3748"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0">
                                <TextBlock Text="📞 เบอร์โทรศัพท์:" FontSize="13" FontWeight="SemiBold" Foreground="#718096"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding CustomerHistoryPhone}"
                                       FontSize="14" FontWeight="Bold" Foreground="#2D3748"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: History DataGrid Table -->
                    <Border Grid.Row="2"
                            Background="#FFFFFF"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            MaxHeight="360"
                            Effect="{StaticResource SoftShadow}">

                        <DataGrid ItemsSource="{Binding CustomerHistoryOrders}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True" 
                                  HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  RowHeight="44"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  CanUserSortColumns="True"
                                  ColumnHeaderStyle="{StaticResource POColumnHeaderStyle}"
                                  RowStyle="{StaticResource PORowStyle}"
                                  CellStyle="{StaticResource POCellStyle}"
                                  SelectionMode="Single">
                            <DataGrid.Columns>

                                <!-- #1: Timestamp -->
                                <DataGridTextColumn Header="วันที่/เวลา"
                                                    Binding="{Binding Timestamp, StringFormat=dd/MM/yyyy HH:mm}"
                                                    Width="1.4*"
                                                    ElementStyle="{StaticResource ColCenter}"/>

                                <!-- #2: RefNo -->
                                <DataGridTextColumn Header="เลขที่บิล"
                                                    Binding="{Binding RefNo}"
                                                    Width="1.8*"
                                                    ElementStyle="{StaticResource ColCenterBold}"/>

                                <!-- #3: Total Amount -->
                                <DataGridTextColumn Header="ยอดสุทธิ"
                                                    Binding="{Binding TotalAmount, StringFormat={}{0:N2}}"
                                                    Width="1.4*"
                                                    ElementStyle="{StaticResource ColAmountStyle}"/>

                                <!-- #4: Payment Method -->
                                <DataGridTextColumn Header="วิธีการชำระ"
                                                    Binding="{Binding PaymentMethod}"
                                                    Width="1.2*"
                                                    ElementStyle="{StaticResource ColCenter}"/>

                                <!-- #5: Delivery Status -->
                                <DataGridTextColumn Header="สถานะจัดส่ง"
                                                    Binding="{Binding DeliveryStatus}"
                                                    Width="1.2*"
                                                    ElementStyle="{StaticResource ColCenter}"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Row 3: Horizontal Separator Line -->
                    <Border Grid.Row="3" Height="1" Background="#BAE6FD" Margin="0,16"/>

                    <!-- Row 4: Footer Summary Bar & Actions -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="จำนวนรายการรวม: " FontSize="15" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBlock Text="{Binding CustomerHistoryTotalOrders}"
                                       FontSize="15" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,24,0"/>

                            <TextBlock Text="ยอดรวมทั้งหมด: " FontSize="15" FontWeight="SemiBold" Foreground="#718096"/>
                            <TextBlock Text="{Binding CustomerHistoryTotalSpent, StringFormat={}{0:N2}}"
                                       FontSize="18" FontWeight="Bold" Foreground="#0B2545"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="ปิดหน้าต่าง"
                                Command="{Binding CloseCustomerHistoryModalCommand}"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Padding="20,0" Height="42"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT STAFF    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsStaffModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="680"
                    MaxWidth="700"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <Border.Resources>
                    <!-- สถานะกล่องข้อความทั่วไป: โหมดดูข้อมูลขอบ #E2E8F0 พื้นหลัง #F8FAFC, โหมดแก้ไขขอบ #38BDF8 พื้นหลัง #FFFFFF -->
                    <Style x:Key="StaffFieldBorderStyle" TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- สถานะกล่องข้อความ Username: แก้ไขได้เฉพาะในโหมดเพิ่มพนักงานใหม่ (IsStaffAddMode = True) -->
                    <Style x:Key="StaffUsernameBorderStyle" TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStaffAddMode}" Value="True">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- กล่องข้อความสไตล์โมเดิร์นมาตรฐาน: Font 16, Height 46, Padding 12,0 -->
                    <Style x:Key="StaffInputTextBoxStyle" TargetType="TextBox">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="CaretBrush" Value="#0F172A"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <!-- ComboBox สไตล์มาตรฐาน: Font 16, Height 46, Padding 12,0 -->
                    <Style x:Key="StaffComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource LightComboBoxStyle}">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <!-- ปุ่มสีฟ้า (แก้ไขข้อมูล / บันทึกข้อมูล): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="StaffBlueBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#0284C7"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มลบ (สีแดง): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="StaffDeleteBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#EF4444"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F87171"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มปิด / ยกเลิก (สีเทาอ่อน): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="StaffNeutralBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <StackPanel>
                    <!-- Header Bar with Title (ลบปุ่มกากบาทมุมขวาบนออก คงเหลือหัวข้อสะอาดตา) -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding StaffModalTitle, FallbackValue='ข้อมูลพนักงาน'}"
                                   FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="18,16"
                            Margin="0,0,0,18">
                        <Grid>
                            <!-- ปรับสัดส่วนคอลัมน์: Column 0 (Username) Width="240", Column 1 (Password) Width="*" -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Username (ชื่อผู้ใช้งาน) - แก้ไขได้เฉพาะในโหมดเพิ่มพนักงานใหม่ -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="ชื่อผู้ใช้งาน / Username" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsStaffAddMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource StaffUsernameBorderStyle}">
                                    <TextBox Text="{Binding StaffUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding CanEditStaffUsername, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource StaffInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Password (รหัสผ่าน) -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="รหัสผ่าน / Password" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource StaffFieldBorderStyle}">
                                    <TextBox Text="{Binding StaffPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource StaffInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Left: Full Name (ชื่อ-นามสกุล) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="ชื่อ-นามสกุล" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource StaffFieldBorderStyle}">
                                    <TextBox Text="{Binding StaffName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource StaffInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Right: Phone Number (เบอร์โทรศัพท์) -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="เบอร์โทรศัพท์" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource StaffFieldBorderStyle}">
                                    <TextBox Text="{Binding StaffPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource StaffInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Full Width: Role / Position (สิทธิ์การใช้งาน) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="สิทธิ์การใช้งาน / ตำแหน่ง" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource StaffFieldBorderStyle}">
                                    <ComboBox SelectedValue="{Binding StaffRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Content"
                                              IsEnabled="{Binding IsEditMode}"
                                              Style="{StaticResource StaffComboBoxStyle}">
                                        <ComboBoxItem Content="ผู้ดูแลระบบ"/>
                                        <ComboBoxItem Content="เจ้าของร้าน"/>
                                        <ComboBoxItem Content="พนักงานทั่วไป"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding StaffValidationMessage}"
                               Visibility="{Binding HasStaffValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Action Buttons Bar -->
                    <!-- 1) ชุดปุ่มโหมดดูข้อมูล (IsEditMode == false): แสดง 3 ปุ่ม [แก้ไขข้อมูล, ลบ, ปิด] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1.1) ปุ่ม "แก้ไขข้อมูล" (สีฟ้า) -->
                        <Button Grid.Column="0"
                                Command="{Binding EnterStaffEditModeCommand}"
                                Style="{StaticResource StaffBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="แก้ไขข้อมูล" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.2) ปุ่ม "ลบ" (สีแดง) -->
                        <Button Grid.Column="2"
                                Command="{Binding DeleteStaffCommand}"
                                Style="{StaticResource StaffDeleteBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="ลบ" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.3) ปุ่ม "ปิด" (สีเทาอ่อน) -->
                        <Button Grid.Column="4"
                                Command="{Binding CloseStaffModalCommand}"
                                Style="{StaticResource StaffNeutralBtnStyle}">
                            <TextBlock Text="ปิด" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- 2) ชุดปุ่มโหมดแก้ไข (IsEditMode == true): แสดง 2 ปุ่ม [บันทึกข้อมูล, ยกเลิก] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 2.1) ปุ่ม "บันทึกข้อมูล" (สีฟ้า) -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveStaffCommand}"
                                Style="{StaticResource StaffBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💾" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="บันทึกข้อมูล" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2.2) ปุ่ม "ยกเลิก" (สีเทาอ่อน) -->
                        <Button Grid.Column="2"
                                Command="{Binding CancelStaffEditCommand}"
                                Style="{StaticResource StaffNeutralBtnStyle}">
                            <TextBlock Text="ยกเลิก" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT PARTNER  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsPartnerModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="680"
                    MaxWidth="700"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <Border.Resources>
                    <!-- สถานะกล่องข้อความทั่วไป: โหมดดูข้อมูลขอบ #E2E8F0 พื้นหลัง #F8FAFC, โหมดแก้ไขขอบ #38BDF8 พื้นหลัง #FFFFFF -->
                    <Style x:Key="PartnerFieldBorderStyle" TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- สถานะกล่องข้อความรหัสคู่ค้า (อ่านอย่างเดียวเสมอ) -->
                    <Style x:Key="PartnerCodeBorderStyle" TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>

                    <!-- กล่องข้อความสไตล์โมเดิร์นมาตรฐาน: Font 16, Height 46, Padding 12,0 -->
                    <Style x:Key="PartnerInputTextBoxStyle" TargetType="TextBox">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="CaretBrush" Value="#0F172A"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <!-- กล่องข้อความหลายบรรทัดสำหรับที่อยู่: Font 16, MinHeight 85, Padding 12,10 -->
                    <Style x:Key="PartnerMultiLineTextBoxStyle" TargetType="TextBox">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="CaretBrush" Value="#0F172A"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="MinHeight" Value="85"/>
                        <Setter Property="Height" Value="85"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="AcceptsReturn" Value="True"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    </Style>

                    <!-- ปุ่มสีฟ้า (แก้ไขข้อมูล / บันทึกข้อมูล): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="PartnerBlueBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#0284C7"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มลบ (สีแดง): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="PartnerDeleteBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#EF4444"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F87171"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มปิด / ยกเลิก (สีเทาอ่อน): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="PartnerNeutralBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <StackPanel>
                    <!-- Header Bar with Title (สะอาดตา ไม่มีปุ่ม x กากบาท) -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding PartnerModalTitle, FallbackValue='ข้อมูลบริษัทคู่ค้า'}"
                                   FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="18,16"
                            Margin="0,0,0,18">
                        <Grid>
                            <!-- ปรับสัดส่วนคอลัมน์: Column 0 (Code) Width="220", Column 1 (Name) Width="*" -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Partner Code (รหัสบริษัทคู่ค้า) - อ่านอย่างเดียวเสมอ -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,14">
                                <TextBlock Text="รหัสบริษัทคู่ค้า" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PartnerCodeBorderStyle}">
                                    <TextBox Text="{Binding PartnerCode, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Foreground="#0284C7"
                                             Style="{StaticResource PartnerInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Partner Name (ชื่อบริษัท / ซัพพลายเออร์) -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="ชื่อบริษัท / ซัพพลายเออร์" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource PartnerFieldBorderStyle}">
                                    <TextBox Text="{Binding PartnerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource PartnerInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Left: Contact Person (ชื่อผู้ติดต่อ) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,14">
                                <TextBlock Text="ชื่อผู้ติดต่อ" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PartnerFieldBorderStyle}">
                                    <TextBox Text="{Binding PartnerContactPerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource PartnerInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Right: Phone Number (เบอร์โทรศัพท์) -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="เบอร์โทรศัพท์" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource PartnerFieldBorderStyle}">
                                    <TextBox Text="{Binding PartnerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource PartnerInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Full Width: Email (อีเมล) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                                <TextBlock Text="อีเมล (Email)" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PartnerFieldBorderStyle}">
                                    <TextBox Text="{Binding PartnerEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource PartnerInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 3 Full Width: Address (ที่อยู่ / รายละเอียดที่ตั้ง) -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <TextBlock Text="ที่อยู่ / รายละเอียดที่ตั้ง" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource PartnerFieldBorderStyle}">
                                    <TextBox Text="{Binding PartnerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource PartnerMultiLineTextBoxStyle}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding PartnerValidationMessage}"
                               Visibility="{Binding HasPartnerValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Action Buttons Bar -->
                    <!-- 1) ชุดปุ่มโหมดดูข้อมูล (IsEditMode == false): แสดง 3 ปุ่ม [แก้ไขข้อมูล, ลบ, ปิด] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1.1) ปุ่ม "แก้ไขข้อมูล" (สีฟ้า) -->
                        <Button Grid.Column="0"
                                Command="{Binding EnterPartnerEditModeCommand}"
                                Style="{StaticResource PartnerBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="แก้ไขข้อมูล" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.2) ปุ่ม "ลบ" (สีแดง) -->
                        <Button Grid.Column="2"
                                Command="{Binding DeletePartnerCommand}"
                                Style="{StaticResource PartnerDeleteBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="ลบ" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.3) ปุ่ม "ปิด" (สีเทาอ่อน) -->
                        <Button Grid.Column="4"
                                Command="{Binding ClosePartnerModalCommand}"
                                Style="{StaticResource PartnerNeutralBtnStyle}">
                            <TextBlock Text="ปิด" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- 2) ชุดปุ่มโหมดแก้ไข (IsEditMode == true): แสดง 2 ปุ่ม [บันทึกข้อมูล, ยกเลิก] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 2.1) ปุ่ม "บันทึกข้อมูล" (สีฟ้า) -->
                        <Button Grid.Column="0"
                                Command="{Binding SavePartnerCommand}"
                                Style="{StaticResource PartnerBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💾" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="บันทึกข้อมูล" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2.2) ปุ่ม "ยกเลิก" (สีเทาอ่อน) -->
                        <Button Grid.Column="2"
                                Command="{Binding CancelPartnerEditCommand}"
                                Style="{StaticResource PartnerNeutralBtnStyle}">
                            <TextBlock Text="ยกเลิก" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT EXPENSE   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsExpenseModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="680"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <Border.Resources>
                    <!-- สถานะกล่องข้อความทั่วไป: โหมดดูข้อมูลขอบ #E2E8F0 พื้นหลัง #F8FAFC, โหมดแก้ไขขอบ #38BDF8 พื้นหลัง #FFFFFF -->
                    <Style x:Key="ExpenseFieldBorderStyle" TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- สถานะกล่องข้อความรหัสรายจ่าย (อ่านอย่างเดียวเสมอ) -->
                    <Style x:Key="ExpenseCodeBorderStyle" TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>

                    <!-- กล่องข้อความสไตล์โมเดิร์นมาตรฐาน: Font 16, Height 46, Padding 12,0 -->
                    <Style x:Key="ExpenseInputTextBoxStyle" TargetType="TextBox">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="CaretBrush" Value="#0F172A"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <!-- กล่องข้อความหลายบรรทัดสำหรับหมายเหตุ: Font 16, MinHeight 85, Padding 12,10 -->
                    <Style x:Key="ExpenseMultiLineTextBoxStyle" TargetType="TextBox">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="CaretBrush" Value="#0F172A"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="MinHeight" Value="85"/>
                        <Setter Property="Height" Value="85"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="AcceptsReturn" Value="True"/>
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    </Style>

                    <!-- ปุ่มสีฟ้า (แก้ไขข้อมูล / บันทึกข้อมูล): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="ExpenseBlueBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#0284C7"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มลบ (สีแดง): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="ExpenseDeleteBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#EF4444"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F87171"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มปิด / ยกเลิก (สีเทาอ่อน): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="ExpenseNeutralBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <StackPanel>
                    <!-- Header Bar with Title (สะอาดตา ไม่มีปุ่ม x กากบาท) -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding ExpenseModalTitle, FallbackValue='ข้อมูลรายจ่าย'}"
                                   FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="18,16"
                            Margin="0,0,0,18">
                        <Grid>
                            <!-- ปรับสัดส่วนคอลัมน์: Column 0 (Code) Width="220", Column 1 (Category) Width="*" -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Expense Code (รหัสรายจ่าย) - อ่านอย่างเดียวเสมอ -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,14">
                                <TextBlock Text="รหัสรายจ่าย" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource ExpenseCodeBorderStyle}">
                                    <TextBox Text="{Binding ExpenseCode, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Foreground="#0284C7"
                                             FontWeight="Bold"
                                             Style="{StaticResource ExpenseInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Expense Category (หมวดหมู่รายจ่าย) -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="หมวดหมู่รายจ่าย" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource ExpenseFieldBorderStyle}">
                                    <ComboBox ItemsSource="{Binding ExpenseCategories}"
                                              SelectedItem="{Binding SelectedExpenseCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsEditMode}"
                                              Style="{StaticResource LightComboBoxStyle}"
                                              Height="46" Padding="12,0" FontSize="16"
                                              Background="Transparent" BorderThickness="0"
                                              VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Left: Expense Amount (จำนวนเงิน บาท) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="จำนวนเงิน (บาท)" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource ExpenseFieldBorderStyle}">
                                    <TextBox Text="{Binding ExpenseAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Foreground="#0284C7"
                                             FontWeight="Bold"
                                             Style="{StaticResource ExpenseInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Right: Expense Date (วันที่บันทึก) -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="วันที่บันทึก" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource ExpenseFieldBorderStyle}">
                                    <DatePicker SelectedDate="{Binding ExpenseDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsEditMode}"
                                                Height="46" Padding="6,0" FontSize="16"
                                                VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Full Width: Expense Description (รายละเอียดรายการ) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="รายละเอียดรายการ" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource ExpenseFieldBorderStyle}">
                                    <TextBox Text="{Binding ExpenseDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource ExpenseInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 3 Full Width: Expense Note (หมายเหตุเพิ่มเติม) -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <TextBlock Text="หมายเหตุเพิ่มเติม" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource ExpenseFieldBorderStyle}">
                                    <TextBox Text="{Binding ExpenseNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource ExpenseMultiLineTextBoxStyle}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding ExpenseValidationMessage}"
                               Visibility="{Binding HasExpenseValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Action Buttons Bar -->
                    <!-- 1) ชุดปุ่มโหมดดูข้อมูล (IsEditMode == false): แสดง 3 ปุ่ม [แก้ไขข้อมูล, ลบ, ปิด] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1.1) ปุ่ม "แก้ไขข้อมูล" (สีฟ้า) -->
                        <Button Grid.Column="0"
                                Command="{Binding EnterExpenseEditModeCommand}"
                                Style="{StaticResource ExpenseBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="แก้ไขข้อมูล" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.2) ปุ่ม "ลบ" (สีแดง) -->
                        <Button Grid.Column="2"
                                Command="{Binding DeleteExpenseCommand}"
                                Style="{StaticResource ExpenseDeleteBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="ลบ" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.3) ปุ่ม "ปิด" (สีเทาอ่อน) -->
                        <Button Grid.Column="4"
                                Command="{Binding CloseExpenseModalCommand}"
                                Style="{StaticResource ExpenseNeutralBtnStyle}">
                            <TextBlock Text="ปิด" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- 2) ชุดปุ่มโหมดแก้ไข (IsEditMode == true): แสดง 2 ปุ่ม [บันทึกข้อมูล, ยกเลิก] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 2.1) ปุ่ม "บันทึกข้อมูล" (สีฟ้า) -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveExpenseCommand}"
                                Style="{StaticResource ExpenseBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💾" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="บันทึกข้อมูล" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2.2) ปุ่ม "ยกเลิก" (สีเทาอ่อน) -->
                        <Button Grid.Column="2"
                                Command="{Binding CancelExpenseEditCommand}"
                                Style="{StaticResource ExpenseNeutralBtnStyle}">
                            <TextBlock Text="ยกเลิก" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT PRODUCT   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsProductFormOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="680"
                    MaxWidth="700"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <Border.Resources>
                    <!-- สถานะกล่องข้อความทั่วไป: โหมดดูข้อมูลขอบ #E2E8F0 พื้นหลัง #F8FAFC, โหมดแก้ไขขอบ #38BDF8 พื้นหลัง #FFFFFF -->
                    <Style x:Key="ProductFieldBorderStyle" TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- สถานะกล่องข้อความรหัสสินค้า (อ่านอย่างเดียวเสมอ) -->
                    <Style x:Key="ProductCodeBorderStyle" TargetType="Border">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>

                    <!-- กล่องข้อความสไตล์โมเดิร์นมาตรฐาน: Font 16, Height 46, Padding 12,0 -->
                    <Style x:Key="ProductInputTextBoxStyle" TargetType="TextBox">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Setter Property="CaretBrush" Value="#0F172A"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <!-- ปุ่มสีฟ้า (แก้ไขข้อมูล / บันทึกข้อมูลสินค้า): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="ProductBlueBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#0284C7"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#38BDF8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มลบ (สีแดง): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="ProductDeleteBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#EF4444"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F87171"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Background" Value="#FECACA"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ปุ่มปิด / ยกเลิก (สีเทาอ่อน): สูง 46, MinWidth 115, Font 16 Bold -->
                    <Style x:Key="ProductNeutralBtnStyle" TargetType="Button">
                        <Setter Property="FontFamily" Value="Noto Sans Thai, Segoe UI, sans-serif"/>
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="MinWidth" Value="115"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="14,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>

                <StackPanel>
                    <!-- Header Bar with Title -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding ProductModalTitle, FallbackValue='ข้อมูลสินค้า'}"
                                   FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="18,16"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Product Code (รหัสสินค้า - อ่านอย่างเดียวเสมอ) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="รหัสสินค้า (อัตโนมัติ)" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource ProductCodeBorderStyle}">
                                    <TextBox Text="{Binding ProductCode, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Foreground="#0284C7"
                                             FontWeight="Bold"
                                             Style="{StaticResource ProductInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Product Name (ชื่อสินค้า) -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="ชื่อสินค้า" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource ProductFieldBorderStyle}">
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource ProductInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Left: Category (หมวดหมู่สินค้า) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="หมวดหมู่สินค้า" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource ProductFieldBorderStyle}" Height="46">
                                    <ComboBox ItemsSource="{Binding ProductCategories}"
                                              DisplayMemberPath="CategoryName"
                                              SelectedValuePath="CategoryID"
                                              SelectedValue="{Binding CategoryID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedItem="{Binding SelectedProductCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              TextSearch.TextPath="CategoryName"
                                              IsEnabled="{Binding IsEditMode}"
                                              Style="{StaticResource LightComboBoxStyle}"
                                              Height="44" Padding="12,0" FontSize="16"
                                              Background="Transparent" BorderThickness="0"
                                              VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Right: Unit (หน่วยนับ) -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="หน่วยนับ" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource ProductFieldBorderStyle}">
                                    <TextBox Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource ProductInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Left: Cost Price (ราคาทุน) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="ราคาทุน (บาท)" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource ProductFieldBorderStyle}">
                                    <TextBox Text="{Binding CostPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource ProductInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 2 Right: Selling Price (ราคาขาย) -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="ราคาขาย (บาท)" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource ProductFieldBorderStyle}">
                                    <TextBox Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             FontWeight="Bold" Foreground="#0284C7"
                                             Style="{StaticResource ProductInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 3 Left: Stock Qty (จำนวนคงเหลือ) -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="จำนวนคงเหลือ" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock Text=" *" FontSize="16" FontWeight="Bold" Foreground="#DC2626"
                                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Border Style="{StaticResource ProductFieldBorderStyle}">
                                    <TextBox Text="{Binding Stock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource ProductInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 3 Right: Reorder Point (จุดสั่งซื้อขั้นต่ำ) -->
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="จุดสั่งซื้อขั้นต่ำ (Reorder Point)" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource ProductFieldBorderStyle}">
                                    <TextBox Text="{Binding ReorderPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource ProductInputTextBoxStyle}"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 4 Full Width: Product Image Upload Section (อัปโหลดรูปภาพสินค้า) -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                                <TextBlock Text="รูปภาพสินค้า" FontSize="16" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Image Preview Box -->
                                        <Border Grid.Column="0" Height="90" Background="#F8FAFC" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                            <Grid>
                                                <!-- Placeholder when no image -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Visibility="{Binding HasImagePath, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock Text="📷" FontSize="28" HorizontalAlignment="Center" Foreground="#94A3B8"/>
                                                    <TextBlock Text="ไม่มีรูปภาพ" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Image Preview -->
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"
                                                       Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Controls & Details -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="รูปภาพสินค้า (.png, .jpg, .webp)" FontSize="13" Foreground="#64748B" Margin="0,0,0,8"/>
                                            
                                            <!-- Buttons visible in Edit Mode -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                                                <!-- Select / Upload Image Button -->
                                                <Button Command="{Binding BrowseImageCommand}"
                                                        Style="{StaticResource ProductBlueBtnStyle}"
                                                        Height="38" MinWidth="110" FontSize="13" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="🖼️" Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="เลือกรูปภาพ" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Remove Image Button -->
                                                <Button Command="{Binding RemoveImageCommand}"
                                                        Style="{StaticResource ProductDeleteBtnStyle}"
                                                        Height="38" MinWidth="100" FontSize="13"
                                                        Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="🗑️" Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="ลบรูปภาพ" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Hint in Read-Only Mode -->
                                            <TextBlock Text="กด 'แก้ไขข้อมูล' เพื่ออัปโหลดหรือเปลี่ยนรูปภาพ"
                                                       FontSize="13" Foreground="#94A3B8" FontStyle="Italic"
                                                       Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}"/>

                                            <!-- File Path / Status Text -->
                                            <TextBlock Text="{Binding ImagePath}"
                                                       FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                                       Visibility="{Binding HasImagePath, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Error Message -->
                    <TextBlock Text="{Binding ProductValidationMessage}"
                               Visibility="{Binding HasProductValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Action Buttons Bar -->
                    <!-- 1) ชุดปุ่มโหมดดูข้อมูล (IsEditMode == false): แสดง 3 ปุ่ม [แก้ไขข้อมูล, ลบ, ปิด] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1.1) ปุ่ม "แก้ไขข้อมูล" (สีฟ้า) -->
                        <Button Grid.Column="0"
                                Command="{Binding EnterProductEditModeCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Style="{StaticResource ProductBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="แก้ไขข้อมูล" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.2) ปุ่ม "ลบ" (สีแดง) -->
                        <Button Grid.Column="2"
                                Command="{Binding StockDeleteProductCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Style="{StaticResource ProductDeleteBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="ลบ" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 1.3) ปุ่ม "ปิด" (สีเทาอ่อน) -->
                        <Button Grid.Column="4"
                                Command="{Binding CloseStockManageModalCommand}"
                                Style="{StaticResource ProductNeutralBtnStyle}">
                            <TextBlock Text="ปิด" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- 2) ชุดปุ่มโหมดแก้ไข / เพิ่ม (IsEditMode == true): แสดง 2 ปุ่ม [บันทึกข้อมูลสินค้า, ยกเลิก] -->
                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 2.1) ปุ่ม "บันทึกข้อมูลสินค้า" (สีฟ้า) -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveProductFormCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Style="{StaticResource ProductBlueBtnStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💾" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="บันทึกข้อมูลสินค้า" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 2.2) ปุ่ม "ยกเลิก" (สีเทาอ่อน) -->
                        <Button Grid.Column="2"
                                Command="{Binding CancelProductEditCommand}"
                                Style="{StaticResource ProductNeutralBtnStyle}">
                            <TextBlock Text="ยกเลิก" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ROOT LEVEL FULL-SCREEN MODAL OVERLAY: ADD / EDIT CATEGORY   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsCategoryModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Grid.RowSpan="99"
              Grid.ColumnSpan="99"
              Panel.ZIndex="999">
            <Border Width="560"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Bar with Title -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,18">
                        <TextBlock Text="{Binding CategoryModalTitle, FallbackValue='⚙️ จัดการประเภทสินค้า'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#0B2545"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Outer Form Container Card (Light Blue Border Grid Container) -->
                    <Border Background="#F0F9FF"
                            BorderBrush="#7DD3FC"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Category Code (รหัสหมวดหมู่ - Auto Generated & Read-Only) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="รหัสหมวดหมู่ (อัตโนมัติ) *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#F1F5F9" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CategoryCode, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             IsReadOnly="True"
                                             Focusable="False"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Height="44" Padding="12,0" FontSize="16" FontWeight="SemiBold" Foreground="#0284C7"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 0 Right: Category Name (ชื่อประเภทสินค้า) -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="ชื่อประเภทสินค้า *" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource LightTextBoxStyle}"
                                             Height="44" Padding="12,0" FontSize="16"/>
                                </Border>
                            </StackPanel>

                            <!-- Row 1 Full Width: Description (รายละเอียดหมวดหมู่) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0">
                                <TextBlock Text="รายละเอียดหมวดหมู่" FontSize="15" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="#7DD3FC" BorderThickness="1.5" CornerRadius="6">
                                    <TextBox Text="{Binding CategoryDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditStockManage}"
                                             Style="{StaticResource MultiLineTextBoxStyle}"
                                             Height="76" Padding="12,8" FontSize="15" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Validation Message -->
                    <TextBlock Text="{Binding CategoryValidationMessage}"
                               Visibility="{Binding HasCategoryValidationMessage, Converter={StaticResource BoolToVis}}"
                               Foreground="#DC2626" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <!-- Action Buttons Bar -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Save Button -->
                        <Button Grid.Column="0"
                                Command="{Binding SaveCategoryCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Content="💾 บันทึกข้อมูล"
                                Style="{StaticResource PrimaryBtnStyle}"
                                BorderBrush="#0284C7" BorderThickness="1.5"
                                Height="46" FontSize="16" FontWeight="Bold"/>

                        <!-- Clear Button (Visible only in Add Mode) -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearCategoryCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Content="✏️ ล้างข้อมูล"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsCategoryEditMode, Converter={StaticResource InverseBoolToVis}}"/>

                        <!-- Delete Button (Visible in Edit Mode) -->
                        <Button Grid.Column="4"
                                Command="{Binding DeleteCategoryCommand}"
                                IsEnabled="{Binding CanEditStockManage}"
                                Content="🗑️ ลบ"
                                Style="{StaticResource DangerBtnStyle}"
                                BorderBrush="#FCA5A5" BorderThickness="1.5"
                                Height="46" Padding="16,0" FontSize="16" FontWeight="Bold"
                                Visibility="{Binding IsCategoryEditMode, Converter={StaticResource BoolToVis}}"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="6"
                                Command="{Binding CloseCategoryModalCommand}"
                                Content="❌ ยกเลิก"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1.5" Foreground="#0284C7"
                                Height="46" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  UNIVERSAL TOP-LEVEL IN-PAGE CONFIRMATION MODAL OVERLAY     -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#A0000000"
              Visibility="{Binding IsMainConfirmOpen, Converter={StaticResource BoolToVis}}"
              Grid.ColumnSpan="99" Grid.RowSpan="99"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Panel.ZIndex="10000">
            <Border Width="440"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icon Avatar Badge -->
                    <Border Width="60" Height="60" CornerRadius="30" Background="#FEF2F2" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="⚠️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="{Binding MainConfirmTitle, FallbackValue='ยืนยันการทำรายการ'}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#0B2545"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Message -->
                    <TextBlock Text="{Binding MainConfirmMessage}"
                               FontSize="15"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Action Buttons Bar: Confirm & Cancel -->
                    <Grid Width="340">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Confirm Button -->
                        <Button Grid.Column="0"
                                Content="✅ ยืนยัน"
                                Command="{Binding ConfirmMainActionCommand}"
                                Style="{StaticResource DangerBtnStyle}"
                                Height="42"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="2"
                                Content="❌ ยกเลิก"
                                Command="{Binding CancelMainActionCommand}"
                                Style="{StaticResource SecondaryBtnStyle}"
                                Height="42"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  UNIVERSAL TOP-LEVEL IN-PAGE ALERT MODAL OVERLAY           -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#A0111827"
              Visibility="{Binding IsMainAlertOpen, Converter={StaticResource BoolToVis}}"
              Grid.ColumnSpan="99" Grid.RowSpan="99"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Panel.ZIndex="10001">
            <Border Width="420"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="4" Direction="270" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Icon Avatar Badge -->
                    <Border Width="60" Height="60" CornerRadius="30" Background="#E0F2FE" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="{Binding MainAlertIcon, FallbackValue='⚠️'}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="{Binding MainAlertTitle, FallbackValue='แจ้งเตือนระบบ'}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#0B2545"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- Message -->
                    <TextBlock Text="{Binding MainAlertMessage}"
                               FontSize="15"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Close/OK Button -->
                    <Button Content="ตกลง"
                            Command="{Binding CloseMainAlertCommand}"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Height="42"
                            Width="140"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
</Grid>
</Window>
