<UserControl x:Class="Porjai20.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Porjai20"
             xmlns:controls="clr-namespace:Porjai20.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             FontFamily="Noto Sans Thai, Segoe UI, sans-serif"
             FontWeight="Normal"
             Background="#F4F7FB"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Hidden">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  LOCAL COLOR PALETTE (High-Contrast Crimson Red Theme)    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="PosBg"          Color="#F4F7FA"/>
        <SolidColorBrush x:Key="PosCard"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PosInput"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PosBorder"      Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PosBorderLight" Color="#CBD5E1"/>

        <SolidColorBrush x:Key="RosePrimary"    Color="#00A3E0"/>
        <SolidColorBrush x:Key="RoseHover"      Color="#0B2545"/>
        <SolidColorBrush x:Key="RosePressed"    Color="#0082B3"/>
        <SolidColorBrush x:Key="RoseSubtle"     Color="#E0F2FE"/>

        <SolidColorBrush x:Key="TextPrimary"    Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#64748B"/>

        <!-- Legacy Alias Brushes for Compatibility -->
        <SolidColorBrush x:Key="DkBg"          Color="#F4F7FA"/>
        <SolidColorBrush x:Key="DkSurface"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DkSurface2"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DkBorder"      Color="#E2E8F0"/>
        <SolidColorBrush x:Key="DkBorderLight" Color="#CBD5E1"/>

        <SolidColorBrush x:Key="PurplePrimary"  Color="#00A3E0"/>
        <SolidColorBrush x:Key="PurpleHover"    Color="#0B2545"/>
        <SolidColorBrush x:Key="PurplePressed"  Color="#0082B3"/>
        <SolidColorBrush x:Key="PurpleSubtle"   Color="#E0F2FE"/>

        <SolidColorBrush x:Key="PastelBlue"     Color="#2B6CB0"/>
        <SolidColorBrush x:Key="PastelMint"     Color="#059669"/>
        <SolidColorBrush x:Key="PastelLavender" Color="#0B2545"/>
        <SolidColorBrush x:Key="PastelAmber"    Color="#D69E2E"/>
        <SolidColorBrush x:Key="PastelRed"      Color="#EF4444"/>
        <SolidColorBrush x:Key="PastelGreen"    Color="#10B981"/>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  PRIMARY BUTTON STYLE WITH HOVER & PRESSED FEEDBACK        -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#00A3E0"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0077B6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#BAE6FD"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  MODAL CLOSE BUTTON STYLE (Circular Soft Pink Badge)       -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
            <Setter Property="Width"               Value="36"/>
            <Setter Property="Height"              Value="36"/>
            <Setter Property="Background"          Value="#FCE4EC"/>
            <Setter Property="Foreground"          Value="#D81B60"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="FontSize"            Value="16"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <TextBlock x:Name="Txt"
                                       Text="✕"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00A3E0"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0082B3"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  KPI CARD STYLE                                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect"          Value="{StaticResource SoftShadow}"/>
        </Style>


        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Padding"    Value="10,8"/>
            <Setter Property="FontFamily" Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,2" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="#0B2545"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00A3E0"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Rose Button Style -->
        <Style x:Key="PurpleBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#00A3E0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0082B3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#BAE6FD"/>
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View Details Outline Button Style -->
        <Style x:Key="ViewDetailsButtonStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#E0F2FE"/>
            <Setter Property="Foreground"      Value="#0B2545"/>
            <Setter Property="BorderBrush"     Value="#00A3E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="MinWidth"        Value="105"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#00A3E0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0B2545"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  DATAGRID STYLES                                           -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="SHColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"              Value="#F1F5F9"/>
            <Setter Property="Foreground"              Value="#000000"/>
            <Setter Property="FontWeight"              Value="Bold"/>
            <Setter Property="FontSize"                Value="16"/>
            <Setter Property="Height"                  Value="48"/>
            <Setter Property="Padding"                 Value="12,0"/>
            <Setter Property="BorderBrush"             Value="#E2E8F0"/>
            <Setter Property="BorderThickness"         Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#000000"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SHRowStyle" TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#2D3748"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="MouseDoubleClick" Handler="SalesHistoryRow_MouseDoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                CornerRadius="8" Margin="0,1" Padding="4,0"
                                Background="Transparent"
                                BorderThickness="0"
                                BorderBrush="Transparent">
                            <DataGridCellsPresenter
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#E0F2FE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground"  Value="#1E293B"/>
                                <Setter Property="FontWeight"  Value="Normal"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                     Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                 Color="#1E293B"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"    Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1E293B"/>
            </Style.Resources>
        </Style>

        <Style x:Key="SHCellStyle" TargetType="DataGridCell">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#1E293B"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Column text alignment helpers -->
        <Style x:Key="ColCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontFamily"          Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="FontSize"            Value="15"/>
        </Style>
        <Style x:Key="ColLeft" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontFamily"          Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="FontSize"            Value="15"/>
            <Setter Property="Margin"              Value="4,0"/>
        </Style>
        <Style x:Key="ColCenterBold" TargetType="TextBlock" BasedOn="{StaticResource ColCenter}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ColRight" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontFamily"          Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="FontSize"            Value="15"/>
            <Setter Property="Margin"              Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ColRightBold" TargetType="TextBlock" BasedOn="{StaticResource ColRight}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ColAmountStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="FontSize"            Value="16"/>
            <Setter Property="FontFamily"          Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Margin"              Value="0,0,8,0"/>
            <Setter Property="Foreground"          Value="#0B2545"/>
        </Style>

        <!-- Modal Footer Button Styles -->
        <Style x:Key="ModalPrintBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#0284C7"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="MinWidth"        Value="120"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalCloseSecondaryBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#F1F5F9"/>
            <Setter Property="BorderBrush"     Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#475569"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="MinWidth"        Value="120"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  MODAL ITEMS DATAGRID STYLES (LIGHT MODAL DIALOG)          -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="LightModalColHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"              Value="#F1F5F9"/>
            <Setter Property="Foreground"              Value="#000000"/>
            <Setter Property="FontWeight"              Value="Bold"/>
            <Setter Property="FontSize"                Value="16"/>
            <Setter Property="Height"                  Value="44"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="BorderBrush"             Value="#E2E8F0"/>
            <Setter Property="BorderThickness"         Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#000000"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightModalRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                CornerRadius="6" Margin="2,1" Padding="4,0"
                                Background="Transparent">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#E0F2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightModalCellStyle" TargetType="DataGridCell">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!--  OUTER ROOT GRID: Clean 100% full-width layout canvas           -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <Grid Background="#E0F2FE"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Hidden">

        <!-- ════════════════════════════════════════════════════════════ -->
        <!--  MAIN PAGE CONTENT CONTAINER (16px margin inside container)  -->
        <!-- ════════════════════════════════════════════════════════════ -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Page Header -->
                <RowDefinition Height="Auto"/>  <!-- KPI Cards  -->
                <RowDefinition Height="Auto"/>  <!-- Filter Bar  -->
                <RowDefinition Height="*"/>     <!-- DataGrid Table -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  ROW 0 — Page Header                                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <!-- Rose Accent Vertical Bar -->
                    <Border Width="5" CornerRadius="3" Margin="0,0,12,0" VerticalAlignment="Stretch">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00A3E0" Offset="0"/>
                                <GradientStop Color="#0B2545" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="📊 ประวัติการขาย"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#2D3748"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="จัดการประวัติการขาย — ระบบจัดการร้าน พอใจ"
                                   FontSize="15"
                                   Foreground="#718096"
                                   Margin="0"/>
                    </StackPanel>
                </StackPanel>

            </DockPanel>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  ROW 1 — KPI Summary Cards (3 cards)                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI Card 1: Total Revenue -->
                <controls:KpiSummaryCard Grid.Column="0"
                                         Title="ยอดขายรวม"
                                         Value="{Binding TotalRevenue, StringFormat={}{0:N2}}"
                                         Subtitle="{Binding RevenueSubLabel}"
                                         IconGlyph="💰"
                                         IconBackground="#E0F2FE"
                                         ValueBrush="#0B2545"/>

                <!-- KPI Card 2: Total Transactions -->
                <controls:KpiSummaryCard Grid.Column="2"
                                         Title="จำนวนออเดอร์"
                                         Value="{Binding TotalOrders}"
                                         Subtitle="{Binding OrdersSubLabel}"
                                         IconGlyph="🧾"
                                         IconBackground="#EBF8FF"
                                         ValueBrush="#0284C7"/>

                <!-- KPI Card 3: Average Ticket -->
                <controls:KpiSummaryCard Grid.Column="4"
                                         Title="ยอดเฉลี่ยต่อบิล"
                                         Value="{Binding AverageTicket, StringFormat={}{0:N2}}"
                                         Subtitle="{Binding AverageSubLabel}"
                                         IconGlyph="📈"
                                         IconBackground="#FEF3C7"
                                         ValueBrush="#D97706"/>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  ROW 2 — Filter / Search Bar                               -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,16"
                    Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>     <!-- Search Box -->
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="140"/>   <!-- Date Range Filter ComboBox -->
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="130"/>   <!-- Payment ComboBox -->
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="85"/>    <!-- Search Button -->
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="75"/>    <!-- Clear Button -->
                    </Grid.ColumnDefinitions>

                    <!-- Search TextBox -->
                    <Border Grid.Column="0"
                            Background="#E0F2FE"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Height="42">
                        <Grid>
                            <!-- Search Icon -->
                            <Path Data="{StaticResource IconSearch}"
                                  Fill="#718096"
                                  Width="18" Height="18"
                                  HorizontalAlignment="Left"
                                  Margin="12,0,0,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <!-- TextBox -->
                            <TextBox x:Name="SalesSearchBox"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Height="42"
                                     Padding="38,0,12,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="15"/>
                            <!-- Placeholder -->
                            <TextBlock Text="ค้นหา รหัสใบเสร็จ, ชื่อลูกค้า..."
                                       Foreground="#A0AEC0"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="38,0,12,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SalesSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Date Range Filter ComboBox -->
                    <Border Grid.Column="2"
                            Background="#E0F2FE"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Height="42">
                        <ComboBox ItemsSource="{Binding DateFilterOptions}"
                                  SelectedItem="{Binding SelectedDateFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource DkComboBoxStyle}"
                                  Height="42"
                                  FontSize="15"
                                  VerticalContentAlignment="Center"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  MaxDropDownHeight="260"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>

                    <!-- Payment Method ComboBox -->
                    <Border Grid.Column="4"
                            Background="#E0F2FE"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            Height="42">
                        <ComboBox ItemsSource="{Binding PaymentMethodOptions}"
                                  SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource DkComboBoxStyle}"
                                  Height="42"
                                  FontSize="15"
                                  VerticalContentAlignment="Center"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  MaxDropDownHeight="260"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>

                    <!-- Search Button -->
                    <Button Grid.Column="6"
                            Content="ค้นหา"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Width="85"
                            Height="42"
                            Padding="0"/>

                    <!-- Clear / Reset Button -->
                    <Button Grid.Column="8"
                            Content="ล้าง"
                            Command="{Binding ClearFilterCommand}"
                            Style="{StaticResource ClearBtnStyle}"
                            Width="75"
                            Height="42"
                            Padding="0"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  ROW 3 — DataGrid Table (Full Width)                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,0,0"
                    Padding="16"
                    Effect="{StaticResource SoftShadow}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="0"
                              x:Name="SalesDataGrid"
                              ItemsSource="{Binding SalesOrders}"
                              SelectedItem="{Binding SelectedOrder}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="True"
                              RowHeight="50"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              ColumnHeaderStyle="{StaticResource SHColumnHeaderStyle}"
                              RowStyle="{StaticResource SHRowStyle}"
                              CellStyle="{StaticResource SHCellStyle}"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <!-- #1: Receipt ID (รหัสใบเสร็จ) -->
                            <DataGridTextColumn Header="รหัสใบเสร็จ"
                                                Binding="{Binding RefNo}"
                                                Width="1.5*"
                                                ElementStyle="{StaticResource ColCenterBold}"/>

                            <!-- #2: Date & Time (วัน-เวลา) -->
                            <DataGridTextColumn Header="วัน-เวลา"
                                                Binding="{Binding Timestamp, StringFormat=dd/MM/yy HH:mm}"
                                                Width="1.3*"
                                                ElementStyle="{StaticResource ColCenter}"/>

                            <!-- #3: Customer Name (ชื่อลูกค้า) -->
                            <DataGridTextColumn Header="ชื่อลูกค้า"
                                                Binding="{Binding CustomerDisplayName}"
                                                Width="1.6*"
                                                ElementStyle="{StaticResource ColLeft}"/>

                            <!-- #4: Total Items (จำนวนรายการ) -->
                            <DataGridTextColumn Header="รายการ"
                                                Binding="{Binding ItemCount}"
                                                Width="0.8*"
                                                ElementStyle="{StaticResource ColRightBold}"/>

                            <!-- #5: Net Amount (ยอดสุทธิ) -->
                            <DataGridTemplateColumn Header="ยอดสุทธิ" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2}}" Style="{StaticResource ColAmountStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- #6: Payment Method (ช่องทางชำระเงิน) -->
                            <DataGridTemplateColumn Header="ช่องทางชำระ" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="PayBadge" CornerRadius="12" Padding="12,4"
                                                HorizontalAlignment="Center"
                                                Background="#E0F2FE">
                                            <TextBlock x:Name="PayText"
                                                       Text="{Binding PaymentMethod}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#0369A1"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="Cash">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#D1FAE5"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#065F46"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="เงินสด">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#D1FAE5"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#065F46"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="QR Code">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#F3E8FF"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#6B21A8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="QR">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#F3E8FF"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#6B21A8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="โอนเงิน">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#F3E8FF"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#6B21A8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="สแกน QR / โอนเงิน">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#F3E8FF"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#6B21A8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="สแกน QR Code">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#F3E8FF"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#6B21A8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="Transfer">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#F3E8FF"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#6B21A8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="Credit Card">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#E0F2FE"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#0369A1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="บัตรเครดิต">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#E0F2FE"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#0369A1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="บัตรเครดิต / เดบิต">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#E0F2FE"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#0369A1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="บัตรเครดิต/เดบิต">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#E0F2FE"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#0369A1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PaymentMethod}" Value="Card">
                                                <Setter TargetName="PayBadge" Property="Background" Value="#E0F2FE"/>
                                                <Setter TargetName="PayText"  Property="Foreground" Value="#0369A1"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- #7: Status (สถานะบิล) -->
                            <DataGridTemplateColumn Header="สถานะบิล" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusBadge" CornerRadius="12" Padding="12,4"
                                                HorizontalAlignment="Center"
                                                Background="#D1FAE5">
                                            <TextBlock x:Name="StatusText"
                                                       Text="{Binding Status}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="#065F46"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="ชำระเงินแล้ว">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#DCFCE7"/>
                                                <Setter TargetName="StatusText"  Property="Foreground" Value="#15803D"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#DCFCE7"/>
                                                <Setter TargetName="StatusText"  Property="Foreground" Value="#15803D"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="รอชำระเงิน">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#FEF3C7"/>
                                                <Setter TargetName="StatusText"  Property="Foreground" Value="#B45309"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#FEF3C7"/>
                                                <Setter TargetName="StatusText"  Property="Foreground" Value="#B45309"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="ยกเลิก">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#FEE2E2"/>
                                                <Setter TargetName="StatusText"  Property="Foreground" Value="#B91C1C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Voided">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#FEE2E2"/>
                                                <Setter TargetName="StatusText"  Property="Foreground" Value="#B91C1C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="โมฆะ">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#FEE2E2"/>
                                                <Setter TargetName="StatusText"  Property="Foreground" Value="#B91C1C"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── Status Bar (bottom of DataGrid panel) ─── -->
                    <!-- ── Status Bar (bottom of DataGrid panel) ─── -->
                    <DockPanel Grid.Row="1"
                               LastChildFill="False"
                               Margin="0,12,0,0">
                        <TextBlock Text="{Binding FilteredSales.Count, StringFormat='แสดงทั้งหมด {0} รายการ'}"
                                   Foreground="#64748B"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"
                                   Margin="4,0,0,0"/>
                        <TextBlock Text="💡 ดับเบิ้ลคลิกที่รายการเพื่อดูรายละเอียดใบเสร็จ"
                                   Foreground="#94A3B8"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right"
                                   Margin="0,0,4,0"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  FULL-SCREEN RECEIPT DETAILS MODAL OVERLAY                 -->
        <!--  (Covers 100% of screen, Panel.ZIndex=99)                  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Background="#80000000"
              Visibility="{Binding IsDetailModalOpen, Converter={StaticResource BoolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Panel.ZIndex="99">
            <Border Width="680"
                    MaxWidth="700"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{DynamicResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Row 0: Header & Receipt Info Inset Card -->
                        <RowDefinition Height="*"/>      <!-- Row 1: Scrollable Items List DataGrid -->
                        <RowDefinition Height="Auto"/>   <!-- Row 2: Sticky Footer (Totals + Action Buttons) -->
                    </Grid.RowDefinitions>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!--  ROW 0: Modal Header & Receipt Info Inset Card         -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <StackPanel Grid.Row="0">
                        <!-- Header (No 'x' close button) -->
                        <DockPanel LastChildFill="False" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧾 " FontSize="22" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="รายละเอียดใบเสร็จ"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0"/>
                                    <TextBlock Text="{Binding SelectedOrder.RefNo, StringFormat='เลขที่ใบเสร็จ: {0}'}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="#64748B"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Receipt Summary Inset Card -->
                        <Border Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Date / Time & Items Count -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="วันเวลาทำรายการ" FontSize="13.5" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedOrder.Timestamp, StringFormat=dd/MM/yyyy HH:mm}"
                                               FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="จำนวนรายการที่ซื้อ: " Foreground="#64748B" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ReceiptItems.Count, StringFormat='{}{0} รายการ'}"
                                                   Foreground="#0F172A" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Payment Method -->
                                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="ช่องทางชำระเงิน" FontSize="13.5" Foreground="#64748B" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                    <Border Background="#E0F2FE" CornerRadius="6" Padding="12,4">
                                        <TextBlock Text="{Binding SelectedOrder.PaymentMethod}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#0369A1"/>
                                    </Border>
                                </StackPanel>

                                <!-- Customer Name -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="ชื่อลูกค้า" FontSize="13.5" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedOrder.CustomerDisplayName}"
                                               FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>

                                <!-- Status -->
                                <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="สถานะบิล" FontSize="13.5" Foreground="#64748B" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                    <Border Background="#D1FAE5" CornerRadius="6" Padding="12,4">
                                        <TextBlock Text="{Binding SelectedOrder.Status}"
                                                   FontSize="15" FontWeight="Bold" Foreground="#065F46"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Divider -->
                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,8"/>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!--  ROW 1: Items List DataGrid (Scrollable)               -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <DataGrid Grid.Row="1"
                              x:Name="ModalItemsDataGrid"
                              ItemsSource="{Binding SelectedOrderItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              CanUserSortColumns="False"
                              RowHeight="44"
                              MinRowHeight="42"
                              MinHeight="140"
                              MaxHeight="220"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              ColumnHeaderStyle="{StaticResource LightModalColHeaderStyle}"
                              RowStyle="{StaticResource LightModalRowStyle}"
                              CellStyle="{StaticResource LightModalCellStyle}"
                              PreviewMouseWheel="ModalItemsDataGrid_PreviewMouseWheel"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="รายการสินค้า"
                                                Binding="{Binding ProductName}"
                                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="FontFamily" Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="จำนวน"
                                                Binding="{Binding Quantity}"
                                                Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="15"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ราคา/หน่วย"
                                                Binding="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="รวมเงิน"
                                                Binding="{Binding Total, StringFormat={}{0:N2}}"
                                                Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!--  ROW 2: Sticky Footer (Payment Summary + Buttons)      -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <StackPanel Grid.Row="2">
                        <!-- Divider -->
                        <Border Height="1" Background="#E2E8F0" Margin="0,4,0,12"/>

                        <!-- Payment Summary Section -->
                        <StackPanel Margin="0,0,0,18">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="รับเงินสด" Foreground="#64748B" FontSize="16"/>
                                <TextBlock Text="{Binding SelectedOrder.CashReceived, StringFormat={}{0:N2}}"
                                           FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="เงินทอน" Foreground="#64748B" FontSize="16"/>
                                <TextBlock Text="{Binding SelectedOrder.Change, StringFormat={}{0:N2}}"
                                           FontSize="16" FontWeight="SemiBold" Foreground="#D97706"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="#E2E8F0" Margin="0,4,0,10"/>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ยอดรวมสุทธิทั้งสิ้น"
                                           Foreground="#0F172A"
                                           FontSize="18" FontWeight="SemiBold"
                                           DockPanel.Dock="Left"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedOrder.TotalAmount, StringFormat={}{0:N2}}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#0284C7"
                                           DockPanel.Dock="Right"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Footer Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Close Button -->
                            <Button Grid.Column="0"
                                    Content="ปิดหน้าต่าง"
                                    Command="{Binding CloseDetailModalCommand}"
                                    Style="{StaticResource ModalCloseSecondaryBtnStyle}"/>

                            <!-- Print Receipt Button -->
                            <Button Grid.Column="2"
                                    x:Name="PrintReceiptBtn"
                                    Content="🖨️  พิมพ์ใบเสร็จ"
                                    Click="PrintReceiptBtn_Click"
                                    Style="{StaticResource ModalPrintBtnStyle}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════ -->
        </Grid>
</UserControl>