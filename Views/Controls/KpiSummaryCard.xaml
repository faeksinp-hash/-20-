<UserControl x:Class="Porjai20.Views.Controls.KpiSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="280"
             x:Name="kpiCardRoot">
    <Border Background="#FFFFFF"
            BorderBrush="#BAE6FD"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16,14"
            Effect="{DynamicResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Icon + Title -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="{Binding IconBackground, ElementName=kpiCardRoot}"
                        Margin="0,0,12,0">
                    <TextBlock Text="{Binding IconGlyph, ElementName=kpiCardRoot}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0"/>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding Title, ElementName=kpiCardRoot}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#718096"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- Row 1: KPI Value -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Value, ElementName=kpiCardRoot}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{Binding ValueBrush, ElementName=kpiCardRoot}"
                       Margin="0,0,0,6"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Row 2: Subtitle / Description -->
            <TextBlock Grid.Row="2"
                       Text="{Binding Subtitle, ElementName=kpiCardRoot}"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="#A0AEC0"
                       Margin="0"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
