<UserControl x:Class="Porjai20.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Porjai20"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FontFamily="Noto Sans Thai, Segoe UI, sans-serif"
             Background="#F4F7FB">

    <UserControl.Resources>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  LOCAL COLOR PALETTE (Cyan / Primary Blue Theme)          -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="PosBg"          Color="#F4F7FA"/>
        <SolidColorBrush x:Key="PosCard"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PosInput"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PosBorder"      Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PosBorderLight" Color="#CBD5E1"/>

        <SolidColorBrush x:Key="RosePrimary"    Color="#00A3E0"/>
        <SolidColorBrush x:Key="RoseHover"      Color="#0B2545"/>
        <SolidColorBrush x:Key="RosePressed"    Color="#0082B3"/>
        <SolidColorBrush x:Key="RoseSubtle"     Color="#E0F2FE"/>

        <SolidColorBrush x:Key="TextPrimary"    Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#475569"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#64748B"/>

        <!-- Soft Shadow Effect -->
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  KPI CARD STYLE                                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="12"/>
            <Setter Property="Padding"         Value="16,14"/>
            <Setter Property="Effect"          Value="{StaticResource SoftShadow}"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  TEXTBOX STYLE                                             -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="LightTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily"             Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="Foreground"             Value="#2D3748"/>
            <Setter Property="CaretBrush"             Value="#2D3748"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="FontSize"               Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      BorderThickness="0" IsTabStop="False"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Disabled"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  COMBOBOX STYLE                                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="LightComboBoxStyle" BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox"/>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  BUTTON STYLES                                             -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#00A3E0"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0077B6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#BAE6FD"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoseBtnStyle" BasedOn="{StaticResource PrimaryBtnStyle}" TargetType="Button"/>

        <!-- Danger Action Button Style -->
        <Style x:Key="DangerBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#DC2626"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F87171"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#B91C1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button Style -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#E0F2FE"/>
            <Setter Property="Foreground"      Value="#0B2545"/>
            <Setter Property="BorderBrush"     Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#BAE6FD"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#7DD3FC"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#7DD3FC"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F3F4F6"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#E0F2FE"/>
            <Setter Property="Foreground"      Value="#0B2545"/>
            <Setter Property="BorderBrush"     Value="#00A3E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#38BDF8"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Modal Close Button Style -->
        <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
            <Setter Property="Width"               Value="32"/>
            <Setter Property="Height"              Value="32"/>
            <Setter Property="Background"          Value="#E0F2FE"/>
            <Setter Property="Foreground"          Value="#0B2545"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="FontSize"            Value="15"/>
            <Setter Property="FontWeight"          Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <TextBlock x:Name="Txt"
                                       Text="✕"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#00A3E0"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0082B3"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  DATAGRID STYLES (Identical to CustomerView & Solid Black) -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Style x:Key="StaffColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"              Value="#F1F5F9"/>
            <Setter Property="Foreground"              Value="#000000"/>
            <Setter Property="FontWeight"              Value="Bold"/>
            <Setter Property="FontSize"                Value="16"/>
            <Setter Property="Height"                  Value="48"/>
            <Setter Property="Padding"                 Value="12,0"/>
            <Setter Property="BorderBrush"             Value="#E2E8F0"/>
            <Setter Property="BorderThickness"         Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#000000"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StaffRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize"   Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                CornerRadius="8" Margin="4,2" Padding="4,0"
                                Background="Transparent">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#BAE6FD"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#BAE6FD"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#000000"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#BAE6FD"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#000000"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#000000"/>
            </Style.Resources>
        </Style>

        <Style x:Key="StaffCellStyle" TargetType="DataGridCell">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#BAE6FD"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#000000"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#BAE6FD"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#000000"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#000000"/>
            </Style.Resources>
        </Style>

        <Style x:Key="ColCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontFamily"          Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Foreground"          Value="#000000"/>
            <Setter Property="TextTrimming"        Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ColCenterBold" TargetType="TextBlock" BasedOn="{StaticResource ColCenter}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style x:Key="ColLeftBold" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontFamily"          Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="Foreground"          Value="#000000"/>
            <Setter Property="TextTrimming"        Value="CharacterEllipsis"/>
        </Style>

    </UserControl.Resources>

    <!-- ════════════════════════════════════════════════════════════════ -->
    <!--  LAYER 1: MAIN VIEW CONTENT GRID                                -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <Grid Visibility="{Binding IsStaffMode, Converter={StaticResource BoolToVis}}" Background="#E0F2FE">

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Row 0: Page Header -->
                <RowDefinition Height="Auto"/>  <!-- Row 1: KPI Cards -->
                <RowDefinition Height="Auto"/>  <!-- Row 2: Search & Filter Bar -->
                <RowDefinition Height="*"/>     <!-- Row 3: DataGrid Table -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  ROW 0 — Page Header                                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5" CornerRadius="3" Margin="0,0,12,0" VerticalAlignment="Stretch">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00A3E0" Offset="0"/>
                                <GradientStop Color="#F4A2B8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="👤 พนักงาน"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#2D3748"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="จัดการข้อมูลพนักงาน — ระบบจัดการร้าน พอใจ"
                                   FontSize="15"
                                   Foreground="#718096"
                                   Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  ROW 1 — KPI Summary Cards (3 Cards Grid)                  -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI Card 1: Total Staff Count -->
                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#E0F2FE" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="40" Height="40" CornerRadius="10" Background="#E0F2FE" Margin="0,0,10,0">
                                <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                            </Border>
                            <TextBlock Text="พนักงานทั้งหมด" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#718096" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding TotalStaffCount}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#0B2545"
                                   Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2"
                                   Text="จำนวนบัญชีพนักงานทั้งหมดในระบบ"
                                   FontSize="11"
                                   Foreground="#A0AEC0"
                                   Margin="0"/>
                    </Grid>
                </Border>

                <!-- KPI Card 2: Active Staff Count -->
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#EBF8FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#BEE3F8"/>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#EBF8FF" Margin="0,0,10,0">
                                <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                            </Border>
                            <TextBlock Text="เข้าปฏิบัติงานวันนี้" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#718096" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding ActiveStaffCount}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#2B6CB0"
                                   Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2"
                                   Text="สถานะพร้อมปฏิบัติงานในระบบ"
                                   FontSize="11"
                                   Foreground="#A0AEC0"
                                   Margin="0"/>
                    </Grid>
                </Border>

                <!-- KPI Card 3: Admin / Manager Count -->
                <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#FEF3C7" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FDE68A"/>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#FEF3C7" Margin="0,0,10,0">
                                <TextBlock Text="👑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                            </Border>
                            <TextBlock Text="ผู้ดูแลระบบ" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#718096" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding AdminStaffCount}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#D69E2E"
                                   Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2"
                                   Text="จำนวนบัญชีระดับผู้ดูแลระบบ (Admin)"
                                   FontSize="11"
                                   Foreground="#A0AEC0"
                                   Margin="0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  ROW 2 — Search & Filter Bar (Identical Layout to Customer)-->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,16"
                    Effect="{StaticResource SoftShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box -->
                    <Border Grid.Column="0"
                            Background="#E0F2FE"
                            BorderBrush="#BAE6FD"
                            BorderThickness="1.5"
                            CornerRadius="8">
                        <Grid>
                            <Path Data="{StaticResource IconSearch}"
                                  Fill="#718096"
                                  Width="18" Height="18"
                                  HorizontalAlignment="Left"
                                  Margin="12,0,0,0"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBox x:Name="StaffSearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                     Style="{StaticResource LightTextBoxStyle}"
                                     Height="40"
                                     Padding="38,0,12,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"/>
                            <TextBlock Text="ค้นหาด้วยรหัส หรือชื่อ..."
                                       Foreground="#A0AEC0"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="38,0,12,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=StaffSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Search Button -->
                    <Button Grid.Column="2" Content="ค้นหา" Command="{Binding SearchStaffCommand}" Style="{StaticResource PrimaryBtnStyle}" Padding="22,0" Height="42"/>

                    <!-- Clear Search Button (ล้าง) -->
                    <Button Grid.Column="4"
                            Content="ล้าง"
                            Command="{Binding ClearStaffFilterCommand}"
                            Style="{StaticResource ClearBtnStyle}"
                            Padding="16,0"
                            Height="42"/>

                    <!-- Manage Staff Action Button (⚙️ จัดการข้อมูล) -->
                    <Button Grid.Column="6"
                            Content="⚙️ จัดการข้อมูล"
                            Command="{Binding OpenStaffManageModalCommand}"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Padding="18,0"
                            Height="42"
                            Margin="0,0,10,0"/>

                    <!-- Add Staff Action Button (➕ เพิ่มข้อมูลพนักงาน) -->
                    <Button Grid.Column="8"
                            Content="➕ เพิ่มข้อมูลพนักงาน"
                            Command="{Binding OpenAddStaffModalCommand}"
                            Style="{StaticResource AddBtnStyle}"
                            Padding="18,0"
                            Height="42"/>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  ROW 3 — Main DataGrid Table                               -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#FFFFFF"
                    BorderBrush="#BAE6FD"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Effect="{StaticResource SoftShadow}">

                <DataGrid ItemsSource="{Binding FilteredStaffs}"
                          SelectedItem="{Binding SelectedStaff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          IsSynchronizedWithCurrentItem="True"
                          SelectionMode="Single"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="True"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          RowHeight="50"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="0"
                          Background="Transparent"
                          ColumnHeaderStyle="{StaticResource StaffColumnHeaderStyle}"
                          RowStyle="{StaticResource StaffRowStyle}"
                          CellStyle="{StaticResource StaffCellStyle}">
                    <DataGrid.Columns>

                        <!-- #1: Staff Code / Username -->
                        <DataGridTextColumn Header="ชื่อผู้ใช้ / รหัสพนักงาน"
                                            Binding="{Binding Username}"
                                            Width="1.5*"
                                            ElementStyle="{StaticResource ColCenterBold}"/>

                        <!-- #2: Full Name -->
                        <DataGridTextColumn Header="ชื่อ-นามสกุล"
                                            Binding="{Binding Name}"
                                            Width="2.2*"
                                            ElementStyle="{StaticResource ColLeftBold}"/>

                        <!-- #3: Phone Number -->
                        <DataGridTextColumn Header="เบอร์โทรศัพท์"
                                            Binding="{Binding Phone}"
                                            Width="1.5*"
                                            ElementStyle="{StaticResource ColCenterBold}"/>

                        <!-- #4: Role / Position -->
                        <DataGridTextColumn Header="สิทธิ์การใช้งาน / ตำแหน่ง"
                                            Binding="{Binding Role}"
                                            Width="1.5*"
                                            ElementStyle="{StaticResource ColCenterBold}"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </Grid>

    </Grid>
</UserControl>