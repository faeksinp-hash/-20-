<Window x:Class="Porjai20.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt" Height="600" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Print Controls -->
            <RowDefinition Height="*"/>    <!-- Receipt Content -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="PrintBtn" Content="พิมพ์ใบเสร็จ" Click="PrintBtn_Click" Width="120" Height="36" Background="#00A3E0" Foreground="White" FontWeight="Bold" FontSize="14">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="White" Padding="20" HorizontalAlignment="Stretch">
            <StackPanel x:Name="PrintArea" Width="320" HorizontalAlignment="Center">
                
                <!-- Shop Header -->
                <TextBlock Text="ร้านพอใจ ทุกอย่าง 20 บาท" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="ใบเสร็จรับเงิน" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                
                <!-- Order Info -->
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="เลขที่บิล:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding RefNo}" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="วันที่:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Timestamp, StringFormat=dd/MM/yyyy HH:mm}" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,5" Visibility="{Binding IsDelivery, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="ชื่อลูกค้า:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CustomerName}" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,15">
                    <TextBlock Text="ชื่อผู้ขาย:" FontWeight="Bold"/>
                    <TextBlock Text="Admin" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- Separator -->
                <Line X1="0" Y1="0" X2="320" Y2="0" Stroke="Black" StrokeThickness="1" StrokeDashArray="2 2" Margin="0,0,0,10"/>

                <!-- Headers -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="รายการ" FontWeight="Bold" Grid.Column="0"/>
                    <TextBlock Text="จำนวน" FontWeight="Bold" Grid.Column="1" TextAlignment="Center"/>
                    <TextBlock Text="รวม" FontWeight="Bold" Grid.Column="2" TextAlignment="Right"/>
                </Grid>

                <!-- Separator -->
                <Line X1="0" Y1="0" X2="320" Y2="0" Stroke="Black" StrokeThickness="1" StrokeDashArray="2 2" Margin="0,0,0,10"/>

                <!-- Items -->
                <ItemsControl x:Name="ItemsGrid">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProductName}" Grid.Column="0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Quantity}" Grid.Column="1" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Total, StringFormat=F2}" Grid.Column="2" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Separator -->
                <Line X1="0" Y1="0" X2="320" Y2="0" Stroke="Black" StrokeThickness="1" StrokeDashArray="2 2" Margin="10,0,0,10"/>

                <!-- Summary -->
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="ยอดรวมสุทธิ:" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat=F2}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="วิธีชำระเงิน:"/>
                    <TextBlock Text="{Binding PaymentMethod}" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="รับเงิน:"/>
                    <TextBlock Text="{Binding CashReceived, StringFormat=F2}" HorizontalAlignment="Right"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,15">
                    <TextBlock Text="เงินทอน:"/>
                    <TextBlock Text="{Binding Change, StringFormat=F2}" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- Separator -->
                <Line X1="0" Y1="0" X2="320" Y2="0" Stroke="Black" StrokeThickness="1" StrokeDashArray="2 2" Margin="0,0,0,15"/>

                <TextBlock Text="ขอบคุณที่ใช้บริการ" HorizontalAlignment="Center" FontWeight="Bold"/>
                
            </StackPanel>
        </Border>
    </Grid>
</Window>
