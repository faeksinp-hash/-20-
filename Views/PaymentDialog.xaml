<Window x:Class="Porjai20.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Porjai20.ViewModels"
        mc:Ignorable="d"
        Title="สรุปยอดเงินและวิธีชำระเงิน"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Noto Sans Thai, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Outer Container with Shadow Padding -->
    <Grid Margin="20" ClipToBounds="False">
        <Border Width="640" Background="#FFFFFF" CornerRadius="18" BorderBrush="#BAE6FD" BorderThickness="2"
                Padding="24" ClipToBounds="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#0B2545" Opacity="0.25"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💳" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="สรุปยอดเงินและการชำระเงิน" FontSize="20" FontWeight="Bold" Foreground="#0B2545" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Click="BtnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Width="34" Height="34">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="xBorder" Background="{TemplateBinding Background}" CornerRadius="17">
                                    <TextBlock Text="✕" Foreground="#64748B" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="xBorder" Property="Background" Value="#FEE2E2"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Customer / Member Info Card -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CustomerName, FallbackValue='ลูกค้าทั่วไป'}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="แต้มสะสม: " FontSize="14" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentPoints, StringFormat='{}{0:N0} แต้ม'}" FontSize="14" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. SUMMARY BOX (With Multi-Promotion Breakdown) -->
                <Border Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="2" CornerRadius="14" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <!-- ยอดรวมสินค้า -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="ยอดรวมสินค้า" FontSize="15" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2}}" FontSize="17" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- ค่าจัดส่ง (ถ้ามี) -->
                        <Grid Margin="0,0,0,6" Visibility="{Binding ShippingFee, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ค่าจัดส่ง" FontSize="15" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ShippingFee, StringFormat={}{0:N2}}" FontSize="17" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- รายการโปรโมชั่นที่ถูกนำมาใช้ทั้งหมด (Multi-Promotion Stacking Breakdown) -->
                        <ItemsControl ItemsSource="{Binding AppliedPromotionDetails}" Visibility="{Binding HasAutoPromotion, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="False" Margin="0,3,0,3">
                                        <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" Foreground="{Binding TextBrush}" Text="{Binding DisplayText}"/>
                                        <TextBlock DockPanel.Dock="Right" FontSize="15" FontWeight="Bold" Foreground="{Binding TextBrush}" Text="{Binding DisplayDiscount}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ส่วนลดแต้มสะสม -->
                        <Grid Margin="0,0,0,6" Visibility="{Binding HasPointDiscount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PointDiscountLabel, FallbackValue='ส่วนลดโปรโมชั่น (แลกแต้ม)'}" FontSize="15" FontWeight="SemiBold" Foreground="#E11D48"/>
                            <TextBlock Text="{Binding DiscountAmount, StringFormat=-{0:N2}}" FontSize="17" FontWeight="Bold" Foreground="#E11D48" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="#CBD5E1" Margin="0,4,0,10"/>

                        <!-- Prominent Grand Total Display -->
                        <Border Background="#F1F5F9" BorderBrush="#00A3E0" BorderThickness="2" CornerRadius="12" Padding="16,10">
                            <Grid>
                                <TextBlock Text="ยอดที่ต้องชำระ" FontSize="17" FontWeight="Bold" Foreground="#0B2545" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NetPayableAmount, StringFormat={}{0:N2}}" FontSize="34" FontWeight="ExtraBold" Foreground="#002288" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Action Buttons: Close / Confirm -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="ปิดหน้าต่าง" Height="44" FontSize="16" FontWeight="SemiBold"
                            Background="#F1F5F9" Foreground="#475569" BorderThickness="1.5" BorderBrush="#CBD5E1"
                            Cursor="Hand" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Content="ตกลง" Height="44" FontSize="16" FontWeight="Bold"
                            Background="#10B981" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="BtnConfirm_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
