<Window x:Class="Porjai20.Views.DeliverySlipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ใบส่งสินค้า (Delivery Slip)" Height="860" Width="680"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        FontFamily="Noto Sans Thai, Leelawadee UI, Segoe UI, Tahoma, sans-serif">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Toolbar Actions Bar (Hidden during print) -->
            <RowDefinition Height="*"/>    <!-- 1: Printable Content -->
        </Grid.RowDefinitions>

        <!-- 0: Top Action Bar -->
        <Border Grid.Row="0" x:Name="HeaderActionsBar" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="🛵" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="ตัวอย่างใบส่งสินค้า" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="PrintBtn" Click="PrintBtn_Click" Height="36" Width="130" Background="#00A3E0" Foreground="White" FontWeight="Bold" FontSize="13.5" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🖨️ " FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="พิมพ์ใบจัดส่ง" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#38BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="CloseBtn" Click="CloseBtn_Click" Height="36" Width="80" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <TextBlock Text="✕ ปิด" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1: Printable Slip Area Inside ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="PrintArea" Background="White" Width="600" Margin="0,15,0,25" Padding="35,30" HorizontalAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Header Section -->
                    <Border BorderBrush="#1E293B" BorderThickness="0,0,0,2" Padding="0,0,0,16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ร้านพอใจ ทุกอย่าง 20 บาท" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="ใบส่งสินค้า / Delivery Slip" FontSize="14" Foreground="#64748B" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Order.RefNo, StringFormat='เลขที่: {0}'}" FontSize="15" FontWeight="Bold" Foreground="#00A3E0" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Order.Timestamp, StringFormat='วันที่: {0:dd/MM/yyyy HH:mm}'}" FontSize="13" Foreground="#475569" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Customer Info Card -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ข้อมูลการจัดส่ง / ลูกค้า" FontWeight="Bold" FontSize="13.5" Foreground="#1E293B" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ชื่อลูกค้า:" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Order.CustomerName}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="เบอร์โทรศัพท์:" Foreground="#64748B" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Order.CustomerPhone}" FontWeight="SemiBold" FontSize="13" Foreground="#00A3E0" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ที่อยู่จัดส่ง:" Foreground="#64748B" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Order.CustomerAddress}" TextWrapping="Wrap" FontSize="13" Foreground="#1E293B" LineHeight="19"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Items Table -->
                    <TextBlock Text="รายการสินค้าที่จัดส่ง" FontWeight="Bold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                    <DataGrid x:Name="ItemsGrid"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              BorderThickness="1"
                              BorderBrush="#E2E8F0"
                              Background="Transparent"
                              RowHeight="34"
                              Margin="0,0,0,16">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ลำดับ" Binding="{Binding Id}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="รายการสินค้า" Binding="{Binding ProductName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                        <Setter Property="Margin" Value="6,0,0,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="ราคา/หน่วย" Binding="{Binding UnitPrice, StringFormat=฿{0:N2}}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="จำนวน" Binding="{Binding Quantity}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="รวมเงิน" Binding="{Binding Total, StringFormat=฿{0:N2}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                        <Setter Property="Margin" Value="0,0,10,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary / Totals Section -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,24">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock Text="ยอดรวมสินค้า" Foreground="#64748B" FontSize="13" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat=฿{0:N2}}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock Text="ค่าจัดส่ง" Foreground="#64748B" FontSize="13" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding ShippingFee, StringFormat=฿{0:N2}}" Foreground="#00A3E0" FontSize="13" FontWeight="SemiBold" DockPanel.Dock="Right"/>
                            </DockPanel>

                            <Border Height="1" Background="#E2E8F0" Margin="0,4,0,8"/>

                            <DockPanel LastChildFill="False">
                                <TextBlock Text="ยอดรวมสุทธิทั้งสิ้น" Foreground="#0F172A" FontSize="14.5" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat=฿{0:N2}}" Foreground="#00A3E0" FontSize="20" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Signature Area -->
                    <Grid Margin="0,15,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Courier -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border BorderBrush="#94A3B8" BorderThickness="0,0,0,1" Width="190" Height="30" Margin="0,0,0,8"/>
                            <TextBlock Text="ผู้จัดส่งสินค้า (Courier)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                            <TextBlock Text="วันที่ _____/_____/_____" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Recipient -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border BorderBrush="#94A3B8" BorderThickness="0,0,0,1" Width="190" Height="30" Margin="0,0,0,8"/>
                            <TextBlock Text="ผู้รับสินค้า (Recipient)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                            <TextBlock Text="วันที่ _____/_____/_____" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
