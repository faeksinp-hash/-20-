<Window x:Class="Porjai20.Views.DeliverySlipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ใบส่งสินค้า" Height="800" Width="600"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="Black" BorderThickness="0,0,0,2" Padding="0,0,0,20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ใบส่งสินค้า" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="ร้านทุกอย่าง 20 บาท" FontSize="18" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RefNo, StringFormat='เลขที่: {0}'}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding Timestamp, StringFormat='วันที่: {0:dd/MM/yyyy HH:mm}'}" FontSize="14" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Customer Info -->
        <Border Grid.Row="1" Background="#F9F9F9" Padding="20" CornerRadius="8" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="ข้อมูลลูกค้า" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ชื่อ-สกุล:" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerName}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="เบอร์โทรศัพท์:" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CustomerPhone}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ที่อยู่จัดส่ง:" Foreground="#666"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CustomerAddress}" TextWrapping="Wrap" LineHeight="20"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Items -->
        <DataGrid Grid.Row="2" Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent"
                  RowHeight="40">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ลำดับ" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="รายการสินค้า / รายละเอียด" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="จำนวน" Binding="{Binding Quantity}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer / Signatures -->
        <Grid Grid.Row="3" Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <Border BorderBrush="Black" BorderThickness="0,0,0,1" Width="200" Height="30" Margin="0,0,0,10"/>
                <TextBlock Text="ผู้ส่งของ" HorizontalAlignment="Center"/>
                <TextBlock Text="วันที่ _____/_____/_____" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#666"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <Border BorderBrush="Black" BorderThickness="0,0,0,1" Width="200" Height="30" Margin="0,0,0,10"/>
                <TextBlock Text="ผู้รับของ" HorizontalAlignment="Center"/>
                <TextBlock Text="วันที่ _____/_____/_____" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="#666"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
