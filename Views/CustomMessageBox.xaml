<Window x:Class="Porjai20.Views.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="แจ้งเตือน"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Noto Sans Thai, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Floating Card Shadow Effect -->
        <DropShadowEffect x:Key="DialogShadow" BlurRadius="25" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.4"/>

        <!-- Primary Button Style -->
        <Style x:Key="DialogPrimaryBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#00A3E0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="MinHeight"       Value="44"/>
            <Setter Property="MinWidth"        Value="100"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0077B6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style for No/Cancel Destructive Actions -->
        <Style x:Key="DialogDangerBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#FEF2F2"/>
            <Setter Property="Foreground"      Value="#DC2626"/>
            <Setter Property="BorderBrush"     Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="MinHeight"       Value="44"/>
            <Setter Property="MinWidth"        Value="100"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="DialogSecondaryBtnStyle" TargetType="Button">
            <Setter Property="FontFamily"      Value="Noto Sans Thai, Leelawadee UI, Segoe UI"/>
            <Setter Property="Background"      Value="#E0F2FE"/>
            <Setter Property="Foreground"      Value="#0B2545"/>
            <Setter Property="BorderBrush"     Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="MinHeight"       Value="44"/>
            <Setter Property="MinWidth"        Value="100"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#7DD3FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Window Content Container with Outer Margin for DropShadow -->
    <Grid Margin="16">
        <Border x:Name="CardBorder"
                Width="420"
                MaxWidth="480"
                Background="#FFFFFF"
                BorderBrush="#BAE6FD"
                BorderThickness="1.5"
                CornerRadius="16"
                Padding="24"
                Effect="{StaticResource DialogShadow}">
            <StackPanel x:Name="MainPanel" HorizontalAlignment="Stretch">

                <!-- Header Drag Handle & Close Button Row -->
                <Grid Margin="0,0,0,12" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="IconContainer" Width="44" Height="44" CornerRadius="22" Background="#E0F2FE" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtIcon" Text="ℹ️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtTitle"
                                   Text="แจ้งเตือน"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Top Right Close Cross Button -->
                    <Button Grid.Column="1"
                            Content="✕"
                            Click="BtnCloseCross_Click"
                            Width="30" Height="30"
                            Background="Transparent"
                            Foreground="#94A3B8"
                            FontSize="14" FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Body Message Text Area -->
                <TextBlock x:Name="TxtMessage"
                           Text="ข้อความแจ้งเตือน"
                           FontSize="14.5"
                           Foreground="#475569"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Margin="0,4,0,24"/>

                <!-- Divider Line -->
                <Border Height="1" Background="#F1F5F9" Margin="0,0,0,16"/>

                <!-- Action Buttons Container -->
                <StackPanel x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- OK Button -->
                    <Button x:Name="BtnOk"
                            Content="ตกลง"
                            Style="{StaticResource DialogPrimaryBtnStyle}"
                            Click="BtnOk_Click"
                            Visibility="Collapsed"
                            Padding="24,0"/>

                    <!-- Yes Button -->
                    <Button x:Name="BtnYes"
                            Content="ใช่"
                            Style="{StaticResource DialogPrimaryBtnStyle}"
                            Click="BtnYes_Click"
                            Visibility="Collapsed"
                            Padding="24,0"/>

                    <!-- No Button -->
                    <Button x:Name="BtnNo"
                            Content="ไม่ใช่"
                            Style="{StaticResource DialogDangerBtnStyle}"
                            Click="BtnNo_Click"
                            Visibility="Collapsed"
                            Padding="24,0"/>

                    <!-- Cancel Button -->
                    <Button x:Name="BtnCancel"
                            Content="ยกเลิก"
                            Style="{StaticResource DialogSecondaryBtnStyle}"
                            Click="BtnCancel_Click"
                            Visibility="Collapsed"
                            Padding="24,0"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
